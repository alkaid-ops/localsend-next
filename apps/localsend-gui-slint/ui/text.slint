export global UiText {
    // Direction and status travel as stable codes ("send"/"receive",
    // "waiting"/"transferring"/...) so comparisons keep working in any language;
    // only the labels shown to the user are translated.
    public pure function transfer-status(status: string) -> string {
        return status == "waiting" ? @tr("等待中")
            : status == "transferring" ? @tr("传输中")
            : status == "finished" ? @tr("已完成")
            : status == "failed" ? @tr("失败")
            : status == "cancelled" ? @tr("已取消")
            : status;
    }

    public pure function transfer-direction(direction: string) -> string {
        return direction == "send" ? @tr("发送") : @tr("接收");
    }
}
