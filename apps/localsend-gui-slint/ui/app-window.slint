import { ScrollView } from "std-widgets.slint";
import { ThemeTokens } from "theme.slint";
import { DeviceItem, DeviceLogItem, FavoriteItem, HistoryItem, LanguageItem, RequestFileItem, SelectedFileItem, TransferItem } from "models.slint";
import {
    FlutterBooleanEntry,
    FlutterBigButton,
    FlutterDialogButton,
    FlutterIconButton,
    FlutterNavItem,
    FlutterSegmentButton,
    FlutterSettingsEntry,
} from "components/common.slint";
import { ReceivePage } from "pages/receive-page.slint";
import { SendPage } from "pages/send-page.slint";
import { SettingsPage } from "pages/settings-page.slint";
import { DialogLayer } from "dialogs/dialog-layer.slint";
export { ThemeTokens }
export { DeviceItem, DeviceLogItem, FavoriteItem, HistoryItem, LanguageItem, RequestFileItem, SelectedFileItem, TransferItem }

export component AppWindow inherits Window {
    title: "LocalSend";
    in property <string> app-version: "0.1.0";
    // Only the initial size is fixed. A preferred width/height here would also
    // become the window's maximum on macOS (Slint derives max from the root
    // layout constraints), which is why the window could grow sideways but
    // never taller, and why the green zoom button only stretched the width.
    preferred-width: root.requested-window-width;
    preferred-height: root.requested-window-height;
    min-width: 600px;
    min-height: 500px;
    max-width: 4096px;
    max-height: 4096px;
    default-font-family: "Avenir Next";
    default-font-size: 15px;
    default-font-weight: 400;
    always-on-top: root.settings-always-on-top;
    background: ThemeTokens.surface;

    // Height reserved for the window controls when the title bar is transparent.
    in-out property <length> titlebar-inset: 28px;
    in-out property <length> requested-window-width: 1024px;
    in-out property <length> requested-window-height: 768px;
    in-out property <string> selected-tab: "receive";
    in-out property <string> server-status: @tr("正在连接 localsendd...");
    in-out property <string> devices-text: "";
    in-out property <string> message: "";

    in-out property <string> device-alias: "LocalSend PC";
    in-out property <string> device-id: "#80";
    in-out property <bool> settings-auto-save-all: false;
    in-out property <bool> settings-auto-save-favorites: false;
    in-out property <bool> settings-auto-finish: true;
    in-out property <bool> settings-send-auto-accept: false;
    in-out property <bool> settings-create-checksums: true;
    in-out property <bool> settings-verify-checksums: true;
    in-out property <bool> settings-save-to-history: true;
    in-out property <int> device-count: 0;
    in-out property <int> active-transfer-count: 0;
    in-out property <bool> sending-active: false;
    in-out property <int> history-count: 0;
    in-out property <bool> server-running: false;
    in-out property <[DeviceItem]> devices: [];
    in-out property <bool> device-details-open: false;
    in-out property <string> device-details-fingerprint: "";
    in-out property <string> device-details-alias: "";
    in-out property <string> device-details-version: "";
    in-out property <string> device-details-address: "";
    in-out property <string> device-details-protocol: "";
    in-out property <bool> device-details-favorite: false;
    in-out property <[DeviceLogItem]> device-details-logs: [];
    in-out property <[FavoriteItem]> favorites: [];
    in-out property <[SelectedFileItem]> selected-files: [];
    in-out property <[HistoryItem]> history-items: [];
    in-out property <[RequestFileItem]> incoming-files: [];
    in-out property <[string]> selected-request-ids: [];
    in-out property <[TransferItem]> transfer-items: [];
    in-out property <string> settings-theme: @tr("跟随系统");
    in-out property <string> settings-theme-code: "system";
    in-out property <string> settings-color: "LocalSend";
    in-out property <string> settings-language-code: "system";
    in-out property <string> settings-language-name: @tr("跟随系统");
    in-out property <[LanguageItem]> language-items: [];
    in-out property <bool> save-window-position: true;
    in-out property <bool> launch-on-login: false;
    in-out property <bool> animations-enabled: true;
    in-out property <bool> settings-daemon-shutdown-supported: false;
    in-out property <bool> text-dialog-open: false;
    in-out property <string> text-message: "";
    in-out property <bool> history-dialog-open: false;
    in-out property <bool> message-received-open: false;
    in-out property <string> message-received-sender: "";
    in-out property <string> message-received-device: "";
    in-out property <string> message-received-text: "";
    in-out property <bool> info-dialog-open: false;
    in-out property <bool> manual-dialog-open: false;
    in-out property <bool> favorites-dialog-open: false;
    in-out property <bool> troubleshoot-dialog-open: false;
    in-out property <string> manual-target: "";
    in-out property <string> info-alias: "";
    in-out property <string> info-ip: "";
    in-out property <string> info-port: "";
    in-out property <string> info-fingerprint: "";
    in-out property <string> destination-dir: "";
    in-out property <int> send-mode: 0;
    in-out property <bool> has-selection: false;
    in-out property <int> selected-file-count: 0;
    in-out property <string> selected-files-text: "";
    in-out property <bool> last-received-visible: false;
    in-out property <string> last-received-title: "";
    in-out property <string> last-received-body: "";
    in-out property <int> incoming-request-count: 0;
    in-out property <string> incoming-request-id: "";
    in-out property <string> incoming-request-title: "";
    in-out property <string> incoming-request-body: "";
    in-out property <string> active-transfer-summary: "";
    in-out property <string> selected-target-label: "";
    in-out property <int> selected-device-count: 0;
    in-out property <bool> freeze-motion: false;
    in-out property <string> selected-total-size: "0 B";
    in-out property <string> settings-device-type: "Desktop";
    in-out property <string> settings-device-model: "";
    in-out property <bool> settings-terms-supported: false;
    in-out property <string> settings-discovery-timeout: "500";
    in-out property <string> settings-multicast-group: "";
    in-out property <string> settings-network-filter: @tr("全部接口");
    in-out property <bool> settings-encryption: true;
    in-out property <bool> settings-always-on-top: false;
    in-out property <bool> settings-minimize-to-tray: true;
    in-out property <bool> settings-require-pin: false;
    in-out property <bool> settings-advanced: false;
    in-out property <length> settings-scroll-y: 0px;
    in-out property <bool> setting-dialog-open: false;
    in-out property <string> setting-edit-key: "";
    in-out property <string> setting-edit-value: "";
    in-out property <bool> pin-dialog-open: false;
    in-out property <string> pin-transfer-id: "";
    in-out property <string> pin-value: "";
    in-out property <bool> web-share-dialog-open: false;
    in-out property <bool> web-share-running: false;
    in-out property <string> web-share-url: "";
    in-out property <bool> settings-pin-enabled: false;
    in-out property <bool> completion-dialog-open: false;
    in-out property <string> completion-file-name: "";
    in-out property <string> completion-file-path: "";
    in-out property <int> completion-countdown: 0;
    in-out property <bool> auto-save-help-dialog-open: false;
    in-out property <bool> language-dialog-open: false;

    out property <length> viewport-width: 1120px;
    out property <length> viewport-height: 760px;
    property <bool> narrow: root.viewport-width <= 700px;
    property <bool> compact-sidebar: root.viewport-width <= 801px;
    property <bool> tablet: root.viewport-width >= 700px && root.viewport-width < 800px;
    property <length> sidebar-width: root.compact-sidebar ? 72px : 248px;

    callback refresh();
    callback toggle-server();
    callback set-auto-save(bool, bool);
    callback choose-file();
    callback choose-folder();
    callback send-text(string);
    callback send-clipboard();
    callback add-manual(string);
    callback toggle-favorite(string);
    callback send-to-device(string);
    callback send-multi();
    callback clear-selection();
    callback set-send-mode(int);
    callback clear-history();
    callback dismiss-message-received();
    callback copy-message-received();
    callback open-destination();
    callback open-troubleshoot-firewall();
    callback cycle-setting(string);
    callback set-theme(string);
    callback open-language(string);
    callback set-language(string);
    callback set-toggle(string, bool);
    callback respond-transfer(string, [string], bool);
    callback toggle-request-file(string);
    callback cancel-transfer(string);
    callback dismiss-transfer(string);
    callback retry-pin(string, string);
    callback dismiss-pin();
    callback open-web-share();
    callback start-web-share();
    callback stop-web-share();
    callback copy-web-share-url();
    callback open-web-share-url();
    callback open-about();
    callback open-support();
    callback open-privacy();
    callback open-terms();
    callback open-changelog();
    callback restart-server();
    callback shutdown-daemon();
    callback edit-setting(string);
    callback submit-setting(string, string);
    callback cancel-setting();
    callback pick-destination();
    callback remove-selected(string);
    callback edit-selection();
    callback open-history-path(string);
    callback show-device-details(string);
    callback close-device-details();
    callback toggle-device-details-favorite(string);
    callback verify-device-details(string);
    callback open-completion-file();
    callback reveal-completion-file();
    callback close-completion();
    callback close-auto-save-help();
    callback copy-diagnostics();

    changed width => { root.viewport-width = root.width; }
    changed height => { root.viewport-height = root.height; }

    message-timeout := Timer {
        interval: 4s;
        running: root.message != "";
        triggered => { root.message = ""; }
    }

    Rectangle {
        width: root.viewport-width;
        height: root.viewport-height;
        horizontal-stretch: 1;
        vertical-stretch: 1;
        background: ThemeTokens.surface;

        VerticalLayout {
            width: root.viewport-width;
            height: root.viewport-height;
            spacing: 0px;
            // The macOS title bar is transparent and the content runs underneath
            // it, so keep the traffic lights clear. Other platforms show a native
            // title bar and need no inset.
            Rectangle {
                height: root.titlebar-inset;
                background: ThemeTokens.surface;
            }
            Rectangle {
                height: root.viewport-height - (root.narrow ? 64px : 0px);
                vertical-stretch: 1;
                horizontal-stretch: 1;
                background: ThemeTokens.surface;

                HorizontalLayout {
                    spacing: 0px;
                    if !root.narrow : Rectangle {
                        width: root.sidebar-width;
                        background: ThemeTokens.nav-surface;
                        VerticalLayout {
                            width: parent.width;
                            padding-left: root.compact-sidebar ? 11px : 13px;
                            padding-right: root.compact-sidebar ? 9px : 11px;
                            padding-top: 25px;
                            padding-bottom: 20px;
                            spacing: 0px;

                            if root.compact-sidebar : Rectangle {
                                height: 40px;
                                background: transparent;
                                Image {
                                    width: 28px;
                                    height: 28px;
                                    x: (parent.width - self.width) / 2;
                                    y: 6px;
                                    source: @image-url("icons/logo.svg");
                                    colorize: ThemeTokens.primary;
                                    image-fit: contain;
                                }
                            }
                            if !root.compact-sidebar : HorizontalLayout {
                                height: 40px;
                                padding-left: 13px;
                                padding-right: 11px;
                                spacing: 10px;
                                alignment: start;
                                Image {
                                    width: 28px;
                                    height: 28px;
                                    y: 6px;
                                    source: @image-url("icons/logo.svg");
                                    colorize: ThemeTokens.primary;
                                    image-fit: contain;
                                }
                                HorizontalLayout {
                                    spacing: 0px;
                                    Text {
                                        text: "Local";
                                        color: ThemeTokens.on-surface;
                                        font-family: "Avenir Next";
                                        font-size: 22px;
                                        font-weight: 650;
                                        letter-spacing: -0.55px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Send";
                                        color: ThemeTokens.primary;
                                        font-family: "Avenir Next";
                                        font-size: 22px;
                                        font-weight: 650;
                                        letter-spacing: -0.55px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            if !root.compact-sidebar : Rectangle {
                                height: 48px;
                                background: transparent;
                            }
                            if root.compact-sidebar : Rectangle {
                                height: 48px;
                                background: transparent;
                            }
                            FlutterNavItem {
                                width: parent.width - (root.compact-sidebar ? 20px : 25px);
                                automation-id: "nav-receive";
                                label: @tr("接收");
                                icon: @image-url("icons/wifi.svg");
                                active: root.selected-tab == "receive";
                                compact: root.compact-sidebar;
                                motion: 1;
                                motion-enabled: root.animations-enabled && !root.freeze-motion;
                                clicked => { root.selected-tab = "receive"; root.message = ""; root.refresh(); }
                            }
                            Rectangle { height: 8px; background: transparent; }
                            FlutterNavItem {
                                width: parent.width - (root.compact-sidebar ? 20px : 25px);
                                automation-id: "nav-send";
                                label: @tr("发送");
                                icon: @image-url("icons/send.svg");
                                active: root.selected-tab == "send";
                                compact: root.compact-sidebar;
                                motion: 2;
                                motion-enabled: root.animations-enabled && !root.freeze-motion;
                                clicked => { root.selected-tab = "send"; root.message = ""; root.refresh(); }
                            }
                            Rectangle { height: 8px; background: transparent; }
                            FlutterNavItem {
                                width: parent.width - (root.compact-sidebar ? 20px : 25px);
                                automation-id: "nav-settings";
                                label: @tr("设置");
                                icon: @image-url("icons/settings.svg");
                                active: root.selected-tab == "settings";
                                compact: root.compact-sidebar;
                                motion: 3;
                                motion-enabled: root.animations-enabled && !root.freeze-motion;
                                clicked => { root.selected-tab = "settings"; root.message = ""; }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                            if root.compact-sidebar : Rectangle {
                                height: 44px;
                                background: transparent;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    x: (parent.width - self.width) / 2;
                                    y: 18px;
                                    border-radius: 4px;
                                    background: root.server-running ? ThemeTokens.success : ThemeTokens.error;
                                }
                            }
                            if !root.compact-sidebar : Rectangle {
                                height: 44px;
                                background: transparent;
                                HorizontalLayout {
                                    width: parent.width;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 7px;
                                        height: 7px;
                                        y: 18px;
                                        border-radius: 4px;
                                        background: root.server-running ? ThemeTokens.success : ThemeTokens.error;
                                        drop-shadow-blur: 8px;
                                        drop-shadow-color: root.server-running ? #69D6A324 : #FFB4AB24;
                                    }
                                    Text {
                                        text: root.server-running ? @tr("接收服务在线") : @tr("接收服务离线");
                                        color: ThemeTokens.on-surface-variant;
                                        font-size: 12px;
                                        height: parent.height;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            height: parent.height;
                            background: ThemeTokens.outline.with-alpha(0.44);
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        background: ThemeTokens.surface;
                        if root.selected-tab == "receive" : ReceivePage {
                            width: root.viewport-width - (root.narrow ? 0px : root.sidebar-width);
                            height: root.viewport-height - (root.narrow ? 64px : 0px);
                            compact-layout: root.compact-sidebar;
                            vertical-stretch: 1;
                            viewport-width: root.viewport-width - (root.narrow ? 0px : root.sidebar-width);
                            viewport-height: root.viewport-height - (root.narrow ? 64px : 0px);
                            container-height: root.viewport-height;
                            alias: root.device-alias;
                            device-id: root.device-id;
                            ip-summary: root.info-ip;
                            port: root.info-port;
                            server-status: root.server-status;
                            server-running: root.server-running;
                            animations: root.animations-enabled;
                            request-id: root.incoming-request-id;
                            request-title: root.incoming-request-title;
                            request-files: root.incoming-files;
                            selected-request-ids: root.selected-request-ids;
                            transfers: root.transfer-items;
                            show-history => { root.history-dialog-open = true; }
                            show-info => { root.info-dialog-open = true; }
                            open-web-share => { root.web-share-dialog-open = true; root.open-web-share(); }
                            open-receive-folder => { root.open-destination(); }
                            toggle-request-file(file-id) => { root.toggle-request-file(file-id); }
                            respond-transfer(request-id, selected, accept) => { root.respond-transfer(request-id, selected, accept); }
                            cancel-transfer(transfer-id) => { root.cancel-transfer(transfer-id); }
                            dismiss-transfer(transfer-id) => { root.dismiss-transfer(transfer-id); }
                        }
                        if root.selected-tab == "send" : SendPage {
                            visible: !root.device-details-open;
                            width: root.viewport-width - (root.narrow ? 0px : root.sidebar-width);
                            height: root.viewport-height - (root.narrow ? 64px : 0px);
                            compact-layout: root.compact-sidebar;
                            vertical-stretch: 1;
                            viewport-width: root.viewport-width - (root.narrow ? 0px : root.sidebar-width);
                            viewport-height: root.viewport-height - (root.narrow ? 64px : 0px);
                            container-height: root.viewport-height;
                            devices: root.devices;
                            selected-files: root.selected-files;
                            transfers: root.transfer-items;
                            selected-target: root.selected-target-label;
                            selected-total-size: root.selected-total-size;
                            selected-files-text: root.selected-files-text;
                            selected-file-count: root.selected-file-count;
                            selected-device-count: root.selected-device-count;
                            sending-active: root.sending-active;
                            send-mode: root.send-mode;
                            status-message: root.message;
                            choose-file => { root.choose-file(); }
                            choose-folder => { root.choose-folder(); }
                            open-text => { root.text-dialog-open = true; }
                            send-clipboard => { root.send-clipboard(); }
                            clear-selection => { root.clear-selection(); }
                            remove-selected(path) => { root.remove-selected(path); }
                            edit-selection => { root.edit-selection(); }
                            refresh => { root.refresh(); }
                            add-manual => { root.manual-dialog-open = true; }
                            open-favorites => { root.favorites-dialog-open = true; }
                            mode-changed(mode) => { root.set-send-mode(mode); }
                            send-to-device(fingerprint) => { root.send-to-device(fingerprint); }
                            device-details(fingerprint) => { root.show-device-details(fingerprint); }
                            toggle-favorite(fingerprint) => { root.toggle-favorite(fingerprint); }
                            send-multi => { root.send-multi(); }
                            cancel-transfer(transfer-id) => { root.cancel-transfer(transfer-id); }
                            dismiss-transfer(transfer-id) => { root.dismiss-transfer(transfer-id); }
                            troubleshoot => { root.troubleshoot-dialog-open = true; }
                        }
                        if root.device-details-open : Rectangle {
                            width: root.viewport-width - (root.narrow ? 0px : root.sidebar-width);
                            height: root.viewport-height - (root.narrow ? 64px : 0px);
                            background: ThemeTokens.surface;
                            VerticalLayout {
                                width: min(parent.width, 780px);
                                height: parent.height;
                                x: (parent.width - self.width) / 2;
                                padding-left: 30px;
                                padding-right: 30px;
                                padding-top: 16px;
                                padding-bottom: 28px;
                                spacing: 16px;
                                HorizontalLayout {
                                    height: 52px;
                                    spacing: 10px;
                                    FlutterIconButton { automation-id: "device-details-back"; icon: @image-url("icons/back.svg"); tooltip: @tr("返回"); clicked => { root.close-device-details(); } }
                                    Text { text: @tr("设备详情"); color: ThemeTokens.on-surface; font-size: 24px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                                }
                                Rectangle {
                                    height: 100px;
                                    border-radius: ThemeTokens.card-radius;
                                    border-width: 1px;
                                    border-color: ThemeTokens.outline-variant;
                                    background: ThemeTokens.surface-container-low;
                                    HorizontalLayout {
                                        padding-left: 18px;
                                        padding-right: 14px;
                                        spacing: 14px;
                                        alignment: center;
                                        Rectangle {
                                            width: 56px;
                                            height: 56px;
                                            border-radius: 12px;
                                            background: ThemeTokens.primary-container;
                                            Image { width: 28px; height: 28px; x: 14px; y: 14px; source: @image-url("icons/smartphone.svg"); colorize: ThemeTokens.primary; image-fit: contain; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            alignment: center;
                                            Text { text: root.device-details-alias; color: ThemeTokens.on-surface; font-size: 22px; font-weight: 600; overflow: elide; }
                                            Text { text: root.device-details-address; color: ThemeTokens.on-surface-variant; font-size: 13px; overflow: elide; }
                                        }
                                        FlutterDialogButton { width: 100px; automation-id: "device-details-favorite"; label: root.device-details-favorite ? @tr("已收藏") : @tr("收藏"); primary: root.device-details-favorite; clicked => { root.toggle-device-details-favorite(root.device-details-fingerprint); } }
                                        FlutterDialogButton { width: 100px; automation-id: "device-details-verify"; label: @tr("验证"); clicked => { root.verify-device-details(root.device-details-fingerprint); } }
                                    }
                                }
                                Rectangle {
                                    height: 154px;
                                    border-radius: ThemeTokens.card-radius;
                                    border-width: 1px;
                                    border-color: ThemeTokens.outline-variant;
                                    background: ThemeTokens.surface-container-low;
                                    VerticalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 9px;
                                        Text { text: @tr("设备信息"); color: ThemeTokens.on-surface; font-size: 16px; font-weight: 600; height: 24px; }
                                        HorizontalLayout { Text { text: @tr("名称"); width: 96px; color: ThemeTokens.on-surface-variant; font-size: 13px; } Text { text: root.device-details-alias; color: ThemeTokens.on-surface; font-size: 13px; horizontal-stretch: 1; overflow: elide; } }
                                        HorizontalLayout { Text { text: @tr("版本"); width: 96px; color: ThemeTokens.on-surface-variant; font-size: 13px; } Text { text: @tr("协议 {}", root.device-details-version); color: ThemeTokens.on-surface; font-size: 13px; horizontal-stretch: 1; overflow: elide; } }
                                        HorizontalLayout { Text { text: @tr("指纹"); width: 96px; color: ThemeTokens.on-surface-variant; font-size: 13px; } Text { text: root.device-details-fingerprint; color: ThemeTokens.on-surface; font-size: 13px; horizontal-stretch: 1; overflow: elide; } }
                                    }
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                    border-radius: ThemeTokens.card-radius;
                                    border-width: 1px;
                                    border-color: ThemeTokens.outline-variant;
                                    background: ThemeTokens.surface-container-low;
                                    VerticalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 6px;
                                        Text { text: @tr("日志"); color: ThemeTokens.on-surface; font-size: 16px; font-weight: 600; height: 24px; }
                                        ScrollView {
                                            vertical-stretch: 1;
                                            content-height: max(self.visible-height, root.device-details-logs.length * 28px);
                                            VerticalLayout {
                                                spacing: 2px;
                                                for item in root.device-details-logs : Text { text: item.text; color: ThemeTokens.on-surface-variant; font-size: 12px; wrap: word-wrap; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.selected-tab == "settings" : SettingsPage {
                            width: root.viewport-width - (root.narrow ? 0px : root.sidebar-width);
                            height: root.viewport-height - (root.narrow ? 64px : 0px);
                            compact-layout: root.compact-sidebar;
                            vertical-stretch: 1;
                            status-message: root.message;
                            viewport-width: root.viewport-width - (root.narrow ? 0px : root.sidebar-width);
                            viewport-height: root.viewport-height - (root.narrow ? 64px : 0px);
                            container-height: root.viewport-height;
                            app-version: root.app-version;
                            brightness: root.settings-theme;
                            theme-code: root.settings-theme-code;
                            color-mode: root.settings-color;
                            language-code: root.settings-language-code;
                            language-name: root.settings-language-name;
                            always-on-top: root.settings-always-on-top;
                            minimize-to-tray: root.settings-minimize-to-tray;
                            save-window-position: root.save-window-position;
                            launch-on-login: root.launch-on-login;
                            animations: root.animations-enabled;
                            auto-save-all: root.settings-auto-save-all;
                            auto-save-favorites: root.settings-auto-save-favorites;
                            auto-finish: root.settings-auto-finish;
                            send-auto-accept: root.settings-send-auto-accept;
                            create-checksums: root.settings-create-checksums;
                            verify-checksums: root.settings-verify-checksums;
                            save-to-history: root.settings-save-to-history;
                            require-pin: root.settings-require-pin;
                            destination: root.destination-dir;
                            server-running: root.server-running;
                            server-status: root.server-status;
                            alias: root.device-alias;
                            device-type: root.settings-device-type;
                            device-model: root.settings-device-model;
                            terms-supported: root.settings-terms-supported;
                            port: root.info-port;
                            discovery-timeout: root.settings-discovery-timeout;
                            multicast-group: root.settings-multicast-group;
                            network-filter: root.settings-network-filter;
                            encryption: root.settings-encryption;
                            advanced: root.settings-advanced;
                            show-daemon-shutdown: root.settings-daemon-shutdown-supported;
                            scroll-y <=> root.settings-scroll-y;
                            cycle-setting(name) => { root.cycle-setting(name); }
                            set-theme(code) => { root.set-theme(code); }
                            set-language(code) => { root.language-dialog-open = true; }
                            set-toggle(name, value) => { root.set-toggle(name, value); }
                            set-auto-save(all, favorites) => { root.set-auto-save(all, favorites); }
                            edit-setting(key) => { root.edit-setting(key); }
                            submit-setting(key, value) => { root.submit-setting(key, value); }
                            toggle-server => { root.toggle-server(); }
                            restart-server => { root.restart-server(); }
                            shutdown-daemon => { root.shutdown-daemon(); }
                            pick-destination => { root.pick-destination(); }
                            open-about => { root.open-about(); }
                            open-support => { root.open-support(); }
                            open-privacy => { root.open-privacy(); }
                            open-terms => { root.open-terms(); }
                            open-changelog => { root.open-changelog(); }
                            open-auto-save-help => { root.auto-save-help-dialog-open = true; }
                            open-history => { root.history-dialog-open = true; }
                            open-troubleshoot => { root.troubleshoot-dialog-open = true; }
                        }
                    }
                }
            }

            if root.narrow && !root.device-details-open : Rectangle {
                height: 64px;
                background: ThemeTokens.surface;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: ThemeTokens.outline.with-alpha(0.44);
                }
                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    alignment: center;
                    FlutterNavItem {
                        width: min(120px, (parent.width - 24px) / 3);
                        automation-id: "nav-receive";
                        label: @tr("接收");
                        icon: @image-url("icons/wifi.svg");
                        active: root.selected-tab == "receive";
                        stacked: true;
                        motion: 1;
                        motion-enabled: root.animations-enabled && !root.freeze-motion;
                        clicked => { root.selected-tab = "receive"; root.message = ""; root.refresh(); }
                    }
                    FlutterNavItem {
                        width: min(120px, (parent.width - 24px) / 3);
                        automation-id: "nav-send";
                        label: @tr("发送");
                        icon: @image-url("icons/send.svg");
                        active: root.selected-tab == "send";
                        stacked: true;
                        motion: 2;
                        motion-enabled: root.animations-enabled && !root.freeze-motion;
                        clicked => { root.selected-tab = "send"; root.message = ""; root.refresh(); }
                    }
                    FlutterNavItem {
                        width: min(120px, (parent.width - 24px) / 3);
                        automation-id: "nav-settings";
                        label: @tr("设置");
                        icon: @image-url("icons/settings.svg");
                        active: root.selected-tab == "settings";
                        stacked: true;
                        motion: 3;
                        motion-enabled: root.animations-enabled && !root.freeze-motion;
                        clicked => { root.selected-tab = "settings"; root.message = ""; }
                    }
                }
            }
        }
    }

    if root.message != "" && !root.sending-active : Rectangle {
        width: min(root.viewport-width - 40px, 360px);
        height: 42px;
        x: root.viewport-width - self.width - 20px;
        y: root.viewport-height - self.height - (root.narrow ? 76px : 20px);
        border-radius: 9px;
        background: ThemeTokens.toast-background;
        drop-shadow-blur: 20px;
        drop-shadow-color: #11221E24;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 9px;
            alignment: center;
            Image {
                width: 17px;
                height: 17px;
                source: @image-url("icons/check.svg");
                colorize: ThemeTokens.toast-foreground;
                image-fit: contain;
            }
            Text {
                text: root.message;
                color: ThemeTokens.toast-foreground;
                font-size: 13px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: ThemeTokens.outline.with-alpha(0.72);
        border-radius: 16px;
        background: transparent;
        z: 80;
    }

    DialogLayer {
        width: 100%;
        height: 100%;
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        text-open: root.text-dialog-open;
        text-value: root.text-message;
        history-open: root.history-dialog-open;
        history-items: root.history-items;
        message-open: root.message-received-open;
        message-sender: root.message-received-sender;
        message-device: root.message-received-device;
        message-text: root.message-received-text;
        info-open: root.info-dialog-open;
        info-alias: root.info-alias;
        info-ip: root.info-ip;
        info-port: root.info-port;
        info-fingerprint: root.info-fingerprint;
        info-protocol: root.settings-encryption ? "HTTPS · LocalSend v2.1" : "HTTP · LocalSend v2.1";
        info-status: root.server-status;
        manual-open: root.manual-dialog-open;
        manual-target: root.manual-target;
        favorites-open: root.favorites-dialog-open;
        favorites: root.favorites;
        devices: root.devices;
        troubleshoot-open: root.troubleshoot-dialog-open;
        pin-open: root.pin-dialog-open;
        pin-value: root.pin-value;
        pin-transfer-id: root.pin-transfer-id;
        setting-open: root.setting-dialog-open;
        setting-value: root.setting-edit-value;
        setting-key: root.setting-edit-key;
        language-open: root.language-dialog-open;
        language-items: root.language-items;
        language-code: root.settings-language-code;
        web-share-open: root.web-share-dialog-open;
        web-share-running: root.web-share-running;
        web-share-url: root.web-share-url;
        web-share-encryption: root.settings-encryption;
        web-share-auto-accept: root.settings-send-auto-accept;
        web-share-pin-enabled: root.settings-pin-enabled;
        completion-open: root.completion-dialog-open;
        completion-file-name: root.completion-file-name;
        completion-file-path: root.completion-file-path;
        completion-countdown <=> root.completion-countdown;
        auto-save-help-open: root.auto-save-help-dialog-open;
        send-text(text) => { root.send-text(text); }
        cancel-text => { root.text-dialog-open = false; root.text-message = ""; }
        clear-history => { root.clear-history(); }
        open-destination => { root.open-destination(); }
        close-history => { root.history-dialog-open = false; }
        open-history-path(path) => { root.open-history-path(path); }
        open-history-message(message, sender) => {
            root.message-received-text = message;
            root.message-received-sender = sender;
            root.message-received-device = "";
            root.message-received-open = true;
        }
        close-message => { root.dismiss-message-received(); }
        copy-message => { root.copy-message-received(); }
        close-info => { root.info-dialog-open = false; }
        add-manual(target) => { root.add-manual(target); }
        close-manual => { root.manual-dialog-open = false; root.manual-target = ""; }
        toggle-favorite(fingerprint) => { root.toggle-favorite(fingerprint); }
        close-favorites => { root.favorites-dialog-open = false; }
        send-multi => { root.send-multi(); }
        open-firewall => { root.open-troubleshoot-firewall(); }
        close-troubleshoot => { root.troubleshoot-dialog-open = false; }
        retry-pin(transfer-id, pin) => { root.retry-pin(transfer-id, pin); root.pin-dialog-open = false; root.pin-value = ""; }
        cancel-pin => { root.dismiss-pin(); }
        submit-setting(key, value) => { root.submit-setting(key, value); }
        cancel-setting => { root.cancel-setting(); }
        start-web-share => { root.start-web-share(); }
        stop-web-share => { root.stop-web-share(); }
        copy-web-share-url => { root.copy-web-share-url(); }
        open-web-share-url => { root.open-web-share-url(); }
        close-web-share => { root.stop-web-share(); root.web-share-dialog-open = false; }
        toggle-web-share-encryption(value) => { root.set-toggle("https", value); }
        toggle-web-share-auto-accept(value) => { root.set-toggle("send_auto_accept", value); }
        toggle-web-share-pin(value) => {
            if value {
                root.edit-setting("pin-enable");
            } else {
                root.edit-setting("pin-disable");
            }
        }
        open-completion => { root.open-completion-file(); root.completion-dialog-open = false; }
        reveal-completion => { root.reveal-completion-file(); root.completion-dialog-open = false; }
        close-completion => { root.close-completion(); }
        close-auto-save-help => { root.close-auto-save-help(); }
        close-language => { root.language-dialog-open = false; }
        language-selected(code) => {
            root.language-dialog-open = false;
            if code == "system" {
                root.set-language("");
            } else {
                root.set-language(code);
            }
        }
        copy-diagnostics => { root.copy-diagnostics(); }
        open-favorites-from-auto-save => {
            root.close-auto-save-help();
            root.favorites-dialog-open = true;
        }
    }
}
