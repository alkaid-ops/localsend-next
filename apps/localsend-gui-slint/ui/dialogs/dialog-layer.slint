import { ScrollView } from "std-widgets.slint";
import { FlutterDialogButton, FlutterIconButton, FlutterSettingsEntry } from "../components/common.slint";
import { ThemeTokens } from "../theme.slint";
import { DeviceItem, FavoriteItem, HistoryItem } from "../models.slint";
component DialogShell inherits Rectangle {
    in property <string> title;
    in property <length> viewport-width: 800px;
    in property <length> viewport-height: 600px;
    callback close-clicked;

    width: 100%;
    height: 100%;
    background: ThemeTokens.scrim;
    Rectangle {
        x: (parent.width - min(560px, parent.width - 48px)) / 2;
        y: (parent.height - min(460px, parent.height - 48px)) / 2;
        width: min(560px, parent.width - 48px);
        height: min(460px, parent.height - 48px);
        border-radius: ThemeTokens.dialog-radius;
        background: ThemeTokens.surface-container-high;
        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            HorizontalLayout {
                height: 40px;
                Text { text: root.title; color: ThemeTokens.on-surface; font-size: 22px; font-weight: 600; horizontal-stretch: 1; }
                FlutterIconButton { icon: @image-url("../icons/close.svg"); tooltip: @tr("关闭"); clicked => { root.close-clicked(); } }
            }
            @children
        }
    }
}

export component DialogLayer inherits Rectangle {
    in property <length> viewport-width: 800px;
    in property <length> viewport-height: 600px;
    in property <bool> text-open: false;
    in-out property <string> text-value: "";
    in property <bool> history-open: false;
    in property <[HistoryItem]> history-items: [];
    in property <bool> message-open: false;
    in property <string> message-sender: "";
    in property <string> message-device: "";
    in property <string> message-text: "";
    in property <bool> info-open: false;
    in property <string> info-alias: "";
    in property <string> info-ip: "";
    in property <string> info-port: "";
    in property <string> info-status: "";
    in property <bool> manual-open: false;
    in-out property <string> manual-target: "";
    in property <bool> favorites-open: false;
    in property <[FavoriteItem]> favorites: [];
    in property <[DeviceItem]> devices: [];
    in property <bool> send-mode-open: false;
    in property <int> send-mode: 0;
    in property <bool> troubleshoot-open: false;
    in property <bool> pin-open: false;
    in-out property <string> pin-value: "";
    in property <string> pin-transfer-id: "";
    in property <bool> setting-open: false;
    in-out property <string> setting-value: "";
    in property <string> setting-key: "";
    in property <bool> web-share-open: false;
    in property <bool> web-share-running: false;
    in property <string> web-share-url: "";
    in property <bool> web-share-encryption: false;
    in property <bool> web-share-auto-accept: false;
    in property <bool> web-share-pin-enabled: false;
    in property <bool> completion-open: false;
    in property <string> completion-file-name: "";
    in property <string> completion-file-path: "";
    in-out property <int> completion-countdown: 0;
    in property <bool> auto-save-help-open: false;

    callback send-text(string);
    callback cancel-text();
    callback clear-history();
    callback open-destination();
    callback close-history();
    callback open-history-path(string);
    callback open-history-message(string, string);
    callback close-message();
    callback copy-message();
    callback close-info();
    callback add-manual(string);
    callback close-manual();
    callback toggle-favorite(string);
    callback close-favorites();
    callback set-send-mode(int);
    callback send-multi();
    callback close-send-mode();
    callback open-firewall();
    callback close-troubleshoot();
    callback retry-pin(string, string);
    callback cancel-pin();
    callback submit-setting(string, string);
    callback cancel-setting();
    callback start-web-share();
    callback stop-web-share();
    callback copy-web-share-url();
    callback open-web-share-url();
    callback close-web-share();
    callback toggle-web-share-encryption(bool);
    callback toggle-web-share-auto-accept(bool);
    callback toggle-web-share-pin(bool);
    callback open-completion();
    callback reveal-completion();
    callback close-completion();
    callback close-auto-save-help();

    width: 100%;
    height: 100%;
    background: transparent;

    Timer {
        interval: 1s;
        running: root.completion-open && root.completion-countdown > 0;
        triggered => {
            if root.completion-countdown <= 1 {
                root.close-completion();
            } else {
                root.completion-countdown -= 1;
            }
        }
    }

    if root.text-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: ThemeTokens.scrim;
        Rectangle {
            x: (parent.width - min(540px, parent.width - 72px)) / 2;
            y: (parent.height - 280px) / 2;
            width: min(540px, parent.width - 72px);
            height: 280px;
            border-radius: ThemeTokens.dialog-radius;
            background: ThemeTokens.surface-container-high;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: @tr("发送文本"); color: ThemeTokens.on-surface; font-size: 22px; font-weight: 600; }
                Rectangle {
                    height: 120px;
                    border-radius: ThemeTokens.input-radius;
                    background: ThemeTokens.surface-container-highest;
                    TextInput {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        text <=> root.text-value;
                        accessible-role: text-input;
                        accessible-label: @tr("发送文本内容");
                        accessible-value <=> root.text-value;
                        accessible-action-set-value(value) => { root.text-value = value; }
                        single-line: false;
                        wrap: word-wrap;
                        color: ThemeTokens.on-surface;
                        selection-background-color: ThemeTokens.primary;
                        selection-foreground-color: ThemeTokens.on-primary;
                        font-size: 16px;
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    FlutterDialogButton { automation-id: "text-cancel"; label: @tr("取消"); clicked => { root.cancel-text(); } }
                    FlutterDialogButton { automation-id: "text-send"; label: @tr("确定"); primary: true; enabled: root.text-value != ""; clicked => { root.send-text(root.text-value); } }
                }
            }
        }
    }

    if root.history-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: ThemeTokens.scrim;
        Rectangle {
            x: (parent.width - min(720px, parent.width - 80px)) / 2;
            y: (parent.height - min(560px, parent.height - 80px)) / 2;
            width: min(720px, parent.width - 80px);
            height: min(560px, parent.height - 80px);
            border-radius: ThemeTokens.dialog-radius;
            background: ThemeTokens.surface-container-high;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                HorizontalLayout {
                    height: 40px;
                    Text { text: @tr("接收历史"); color: ThemeTokens.on-surface; font-size: 22px; font-weight: 600; horizontal-stretch: 1; }
                    FlutterIconButton { icon: @image-url("../icons/close.svg"); tooltip: @tr("关闭"); clicked => { root.close-history(); } }
                }
                ScrollView {
                    vertical-stretch: 1;
                    content-height: max(self.visible-height, root.history-items.length * 74px);
                    VerticalLayout {
                        spacing: 6px;
                        if root.history-items.length == 0 : Text { text: @tr("还没有接收记录"); color: ThemeTokens.on-surface-variant; font-size: 15px; }
                        for item in root.history-items : Rectangle {
                            height: item.is-message ? 86px : 66px;
                            border-radius: ThemeTokens.card-radius;
                            background: ThemeTokens.surface-container;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 3px;
                                Text { text: item.name; color: ThemeTokens.on-surface; font-size: 15px; font-weight: 600; overflow: elide; }
                                Text { text: item.subtitle; color: ThemeTokens.on-surface-variant; font-size: 12px; overflow: elide; }
                                if item.is-message : Text { text: item.message; color: ThemeTokens.on-surface; font-size: 13px; wrap: word-wrap; }
                                if item.path != "" : Text { text: item.path; color: ThemeTokens.primary; font-size: 12px; overflow: elide; }
                            }
                            TouchArea {
                                clicked => {
                                    if (item.is-message) {
                                        root.open-history-message(item.message, item.subtitle);
                                    } else if (item.path != "") {
                                        root.open-history-path(item.path);
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    FlutterDialogButton { label: @tr("打开接收目录"); clicked => { root.open-destination(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    FlutterDialogButton { label: @tr("清空历史"); enabled: root.history-items.length > 0; clicked => { root.clear-history(); } }
                    FlutterDialogButton { label: @tr("关闭"); primary: true; clicked => { root.close-history(); } }
                }
            }
        }
    }

    if root.message-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: ThemeTokens.surface;

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding-left: 48px;
            padding-right: 48px;
            padding-top: 36px;
            padding-bottom: 36px;
            spacing: 14px;
            alignment: center;

            Text {
                text: root.message-sender;
                color: ThemeTokens.on-surface;
                font-size: 42px;
                font-weight: 400;
                horizontal-alignment: center;
                overflow: elide;
            }
            if root.message-device != "" : Rectangle {
                height: 32px;
                width: device-label.preferred-width + 24px;
                border-radius: 7px;
                background: ThemeTokens.secondary-container;
                device-label := Text {
                    text: root.message-device;
                    color: ThemeTokens.on-secondary-container;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: @tr("发送给你了一条消息：");
                color: ThemeTokens.on-surface;
                font-size: 16px;
                horizontal-alignment: center;
            }
            Rectangle {
                width: min(640px, parent.width - 48px);
                height: 180px;
                border-radius: 16px;
                background: ThemeTokens.surface-container-high;
                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, message-body.preferred-height + 28px);
                    message-body := Text {
                        x: 16px;
                        y: 14px;
                        width: parent.width - 32px;
                        text: root.message-text;
                        color: ThemeTokens.on-surface;
                        font-size: 18px;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                height: 48px;
                spacing: 18px;
                alignment: center;
                FlutterDialogButton {
                    automation-id: "message-copy";
                    label: @tr("复制");
                    primary: true;
                    clicked => { root.copy-message(); }
                }
                FlutterDialogButton {
                    automation-id: "message-close";
                    label: @tr("关闭");
                    clicked => { root.close-message(); }
                }
            }
        }
    }

    if root.info-open : DialogShell {
        title: @tr("网络信息");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.close-info(); }
        VerticalLayout {
            spacing: 14px;
            Text { text: @tr("设备名称：") + root.info-alias; color: ThemeTokens.on-surface; font-size: 15px; }
            Text { text: @tr("IP 地址：") + root.info-ip; color: ThemeTokens.on-surface; font-size: 15px; wrap: word-wrap; }
            Text { text: @tr("端口：") + root.info-port; color: ThemeTokens.on-surface; font-size: 15px; }
            Text { text: @tr("状态：") + root.info-status; color: ThemeTokens.on-surface-variant; font-size: 13px; wrap: word-wrap; }
        }
    }

    if root.manual-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: ThemeTokens.scrim;
        Rectangle {
            x: (parent.width - min(480px, parent.width - 80px)) / 2;
            y: (parent.height - 250px) / 2;
            width: min(480px, parent.width - 80px);
            height: 250px;
            border-radius: ThemeTokens.dialog-radius;
            background: ThemeTokens.surface-container-high;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: @tr("手动添加设备"); color: ThemeTokens.on-surface; font-size: 22px; font-weight: 600; }
                Rectangle {
                    height: 48px;
                    border-radius: ThemeTokens.input-radius;
                    background: ThemeTokens.surface-container-highest;
                    TextInput { x: 10px; y: 8px; width: parent.width - 20px; height: 32px; text <=> root.manual-target; color: ThemeTokens.on-surface; font-size: 15px; }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    FlutterDialogButton { label: @tr("取消"); clicked => { root.close-manual(); } }
                    FlutterDialogButton { label: @tr("添加"); primary: true; enabled: root.manual-target != ""; clicked => { root.add-manual(root.manual-target); } }
                }
            }
        }
    }

    if root.favorites-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: ThemeTokens.scrim;
        Rectangle {
            x: (parent.width - min(640px, parent.width - 80px)) / 2;
            y: (parent.height - min(560px, parent.height - 80px)) / 2;
            width: min(640px, parent.width - 80px);
            height: min(560px, parent.height - 80px);
            border-radius: ThemeTokens.dialog-radius;
            background: ThemeTokens.surface-container-high;
            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                HorizontalLayout {
                    height: 40px;
                    Text { text: @tr("收藏设备"); color: ThemeTokens.on-surface; font-size: 22px; font-weight: 600; horizontal-stretch: 1; }
                    FlutterIconButton { icon: @image-url("../icons/close.svg"); tooltip: @tr("关闭"); clicked => { root.close-favorites(); } }
                }
                Text { text: @tr("收藏设备可用于自动保存规则。"); color: ThemeTokens.on-surface-variant; font-size: 13px; }
                ScrollView {
                    vertical-stretch: 1;
                    content-height: max(self.visible-height, (root.favorites.length + root.devices.length) * 58px);
                    VerticalLayout {
                        spacing: 6px;
                        for favorite in root.favorites : HorizontalLayout {
                            height: 50px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            Image { width: 20px; height: 20px; source: @image-url("../icons/heart.svg"); colorize: ThemeTokens.primary; image-fit: contain; }
                            Text { text: favorite.alias; color: ThemeTokens.on-surface; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                            FlutterDialogButton { label: @tr("移除"); clicked => { root.toggle-favorite(favorite.fingerprint); } }
                        }
                        for device in root.devices : HorizontalLayout {
                            visible: !device.favorite;
                            height: 50px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            Image { width: 20px; height: 20px; source: @image-url("../icons/heart.svg"); colorize: ThemeTokens.on-surface-variant; image-fit: contain; }
                            Text { text: device.alias + " · " + device.ip; color: ThemeTokens.on-surface; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                            FlutterDialogButton { label: @tr("收藏"); primary: true; clicked => { root.toggle-favorite(device.fingerprint); } }
                        }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    FlutterDialogButton { label: @tr("关闭"); primary: true; clicked => { root.close-favorites(); } }
                }
            }
        }
    }

    if root.send-mode-open : DialogShell {
        title: @tr("发送模式");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.close-send-mode(); }
        VerticalLayout {
            spacing: 12px;
            Text { text: root.send-mode == 0 ? @tr("单选模式：点击设备后立即发送。") : @tr("多选模式：选择设备后按发送按钮。"); color: ThemeTokens.on-surface-variant; font-size: 14px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                FlutterDialogButton { label: @tr("单选"); primary: root.send-mode == 0; clicked => { root.set-send-mode(0); } }
                FlutterDialogButton { label: @tr("多选"); primary: root.send-mode == 1; clicked => { root.set-send-mode(1); } }
                FlutterDialogButton { label: @tr("发送"); primary: true; enabled: root.send-mode == 1; clicked => { root.send-multi(); } }
            }
        }
    }

    if root.completion-open : DialogShell {
        title: @tr("打开文件");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.close-completion(); }
        VerticalLayout {
            spacing: 12px;
            Text { text: @tr("您是否要打开接收的文件？"); color: ThemeTokens.on-surface-variant; font-size: 14px; }
            Text { text: root.completion-file-name; color: ThemeTokens.on-surface; font-size: 17px; font-weight: 600; overflow: elide; }
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 8px;
                FlutterDialogButton { label: @tr("打开"); primary: true; enabled: root.completion-file-path != ""; clicked => { root.open-completion(); } }
                FlutterDialogButton { label: @tr("在文件管理器中显示"); enabled: root.completion-file-path != ""; clicked => { root.reveal-completion(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton {
                    label: root.completion-countdown > 0 ? @tr("关闭 (") + root.completion-countdown + ")" : @tr("关闭");
                    clicked => { root.close-completion(); }
                }
            }
        }
    }

    if root.auto-save-help-open : DialogShell {
        title: @tr("自动保存");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.close-auto-save-help(); }
        VerticalLayout {
            spacing: 12px;
            Text {
                text: @tr("自动接受所有文件传输请求。请注意，这会让此网络中的所有人都可以向你发送文件。");
                color: ThemeTokens.on-surface;
                font-size: 14px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { label: @tr("关闭"); primary: true; clicked => { root.close-auto-save-help(); } }
            }
        }
    }

    if root.troubleshoot-open : DialogShell {
        title: @tr("故障排除");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.close-troubleshoot(); }
        VerticalLayout {
            spacing: 12px;
            Text { text: @tr("设备不可见：确认设备连接到同一 Wi-Fi 或局域网，并检查防火墙权限。"); color: ThemeTokens.on-surface; font-size: 14px; wrap: word-wrap; }
            Text { text: @tr("连接失败：检查端口、HTTPS、PIN 和目标设备的网络隔离设置。"); color: ThemeTokens.on-surface; font-size: 14px; wrap: word-wrap; }
            FlutterDialogButton { label: @tr("打开防火墙设置"); clicked => { root.open-firewall(); } }
        }
    }

    if root.pin-open : DialogShell {
        title: @tr("输入接收方 PIN");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.cancel-pin(); }
        VerticalLayout {
            spacing: 12px;
            Text { text: @tr("目标设备要求 PIN 才会接收传输。"); color: ThemeTokens.on-surface-variant; font-size: 14px; wrap: word-wrap; }
            Rectangle {
                height: 48px;
                border-radius: ThemeTokens.input-radius;
                background: ThemeTokens.surface-container-highest;
                TextInput {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: 32px;
                    text <=> root.pin-value;
                    accessible-role: text-input;
                    accessible-label: @tr("PIN 值");
                    accessible-value <=> root.pin-value;
                    accessible-action-set-value(value) => { root.pin-value = value; }
                    color: ThemeTokens.on-surface;
                    font-size: 16px;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { automation-id: "pin-cancel"; label: @tr("取消"); clicked => { root.cancel-pin(); } }
                FlutterDialogButton { automation-id: "pin-retry"; label: @tr("重试"); primary: true; enabled: root.pin-value != ""; clicked => { root.retry-pin(root.pin-transfer-id, root.pin-value); } }
            }
        }
    }

    if root.setting-open : DialogShell {
        title: @tr("编辑设置");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.cancel-setting(); }
        VerticalLayout {
            spacing: 12px;
            Text { text: root.setting-key; color: ThemeTokens.on-surface-variant; font-size: 13px; }
            Rectangle {
                height: 48px;
                border-radius: ThemeTokens.input-radius;
                background: ThemeTokens.surface-container-highest;
                TextInput {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: 32px;
                    text <=> root.setting-value;
                    accessible-role: text-input;
                    accessible-label: @tr("设置值");
                    accessible-value <=> root.setting-value;
                    accessible-action-set-value(value) => { root.setting-value = value; }
                    color: ThemeTokens.on-surface;
                    font-size: 15px;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { automation-id: "setting-cancel"; label: @tr("取消"); clicked => { root.cancel-setting(); } }
                FlutterDialogButton { automation-id: "setting-save"; label: @tr("保存"); primary: true; clicked => { root.submit-setting(root.setting-key, root.setting-value); } }
            }
        }
    }

    if root.web-share-open : Rectangle {
        width: 100%;
        height: 100%;
        background: ThemeTokens.surface;
        VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;
            HorizontalLayout {
                height: 56px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                FlutterIconButton {
                    icon: @image-url("../icons/back.svg");
                    tooltip: @tr("返回");
                    clicked => { root.close-web-share(); }
                }
                Text {
                    text: @tr("通过链接接收");
                    color: ThemeTokens.on-surface;
                    font-size: 22px;
                    horizontal-stretch: 1;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle { width: 40px; background: transparent; }
            }
            Rectangle {
                vertical-stretch: 1;
                background: transparent;
                VerticalLayout {
                    x: (parent.width - min(580px, parent.width - 48px)) / 2;
                    y: 24px;
                    width: min(580px, parent.width - 48px);
                    height: 300px;
                    spacing: 18px;
                    Text { text: @tr("在浏览器中打开链接："); color: ThemeTokens.on-surface; font-size: 18px; font-weight: 600; }
                    Rectangle {
                        height: 64px;
                        border-radius: ThemeTokens.input-radius;
                        background: ThemeTokens.surface-container-high;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 10px;
                            spacing: 8px;
                            Text { text: root.web-share-url; color: ThemeTokens.on-surface; font-size: 16px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                            FlutterDialogButton { label: @tr("复制"); enabled: root.web-share-url != ""; clicked => { root.copy-web-share-url(); } }
                            FlutterDialogButton { label: @tr("打开"); enabled: root.web-share-url != ""; clicked => { root.open-web-share-url(); } }
                        }
                    }
                    HorizontalLayout {
                        height: 36px; spacing: 8px;
                        accessible-role: checkbox; accessible-label: @tr("加密");
                        accessible-checked: root.web-share-encryption;
                        accessible-action-default => { root.toggle-web-share-encryption(!root.web-share-encryption); }
                        Text { text: @tr("加密"); color: ThemeTokens.on-surface; font-size: 16px; vertical-alignment: center; }
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 3px; border-width: 1px;
                            border-color: root.web-share-encryption ? ThemeTokens.primary : ThemeTokens.outline;
                            background: root.web-share-encryption ? ThemeTokens.primary : transparent;
                            if root.web-share-encryption : Image { width: 14px; height: 14px; x: 3px; y: 3px; source: @image-url("../icons/check.svg"); colorize: ThemeTokens.on-primary; image-fit: contain; }
                        }
                        TouchArea { clicked => { root.toggle-web-share-encryption(!root.web-share-encryption); } }
                    }
                    HorizontalLayout {
                        height: 36px; spacing: 8px;
                        accessible-role: checkbox; accessible-label: @tr("自动接受请求");
                        accessible-checked: root.web-share-auto-accept;
                        accessible-action-default => { root.toggle-web-share-auto-accept(!root.web-share-auto-accept); }
                        Text { text: @tr("自动接受请求"); color: ThemeTokens.on-surface; font-size: 16px; vertical-alignment: center; }
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 3px; border-width: 1px;
                            border-color: root.web-share-auto-accept ? ThemeTokens.primary : ThemeTokens.outline;
                            background: root.web-share-auto-accept ? ThemeTokens.primary : transparent;
                            if root.web-share-auto-accept : Image { width: 14px; height: 14px; x: 3px; y: 3px; source: @image-url("../icons/check.svg"); colorize: ThemeTokens.on-primary; image-fit: contain; }
                        }
                        TouchArea { clicked => { root.toggle-web-share-auto-accept(!root.web-share-auto-accept); } }
                    }
                    HorizontalLayout {
                        height: 36px; spacing: 8px;
                        accessible-role: checkbox; accessible-label: @tr("启用 PIN 密码");
                        accessible-checked: root.web-share-pin-enabled;
                        accessible-action-default => { root.toggle-web-share-pin(!root.web-share-pin-enabled); }
                        Text { text: @tr("启用 PIN 密码"); color: ThemeTokens.on-surface; font-size: 16px; vertical-alignment: center; }
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 3px; border-width: 1px;
                            border-color: root.web-share-pin-enabled ? ThemeTokens.primary : ThemeTokens.outline;
                            background: root.web-share-pin-enabled ? ThemeTokens.primary : transparent;
                            if root.web-share-pin-enabled : Image { width: 14px; height: 14px; x: 3px; y: 3px; source: @image-url("../icons/check.svg"); colorize: ThemeTokens.on-primary; image-fit: contain; }
                        }
                        TouchArea { clicked => { root.toggle-web-share-pin(!root.web-share-pin-enabled); } }
                    }
                }
            }
        }
    }
}

