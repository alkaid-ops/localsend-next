import { ScrollView } from "std-widgets.slint";
import { FlutterDialogButton, FlutterIconButton, FlutterOutlinedButton, FlutterSettingsEntry } from "../components/common.slint";
import { ThemeTokens } from "../theme.slint";
import { DeviceItem, FavoriteItem, HistoryItem, LanguageItem } from "../models.slint";
component DialogShell inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <length> viewport-width: 800px;
    in property <length> viewport-height: 600px;
    in property <length> target-width: 560px;
    in property <length> target-height: 420px;
    callback close-clicked;

    accessible-role: groupbox;
    accessible-label: root.title;
    accessible-id: "dialog-shell";

    width: 100%;
    height: 100%;
    background: ThemeTokens.scrim;
    Rectangle {
        accessible-role: groupbox;
        accessible-label: root.title;
        accessible-id: "dialog-panel";
        x: (parent.width - min(root.target-width, parent.width - 32px)) / 2;
        y: (parent.height - min(root.target-height, parent.height - 32px)) / 2;
        width: min(root.target-width, parent.width - 32px);
        height: min(root.target-height, parent.height - 32px);
        border-radius: ThemeTokens.dialog-radius;
        border-width: 1px;
        border-color: ThemeTokens.outline.with-alpha(0.46);
        background: ThemeTokens.surface;
        drop-shadow-blur: 24px;
        drop-shadow-color: #0000003D;
        VerticalLayout {
            padding-left: 23px;
            padding-right: 23px;
            padding-top: 22px;
            padding-bottom: 18px;
            spacing: 0px;
            HorizontalLayout {
                height: 62px;
                padding-bottom: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 1px;
                    alignment: start;
                    Rectangle {
                        height: 31px;
                        background: transparent;
                        Text { width: parent.width; height: parent.height; y: -2px; text: root.title; color: ThemeTokens.on-surface; font-family: "Avenir Next"; font-size: 22px; font-weight: 620; letter-spacing: -0.44px; }
                    }
                    if root.subtitle != "" : Text { text: root.subtitle; color: ThemeTokens.on-surface-variant; font-size: 12px; }
                }
                FlutterIconButton { icon: @image-url("../icons/close.svg"); tooltip: @tr("关闭"); clicked => { root.close-clicked(); } }
            }
            VerticalLayout {
                vertical-stretch: 1;
                padding-top: 4px;
                spacing: 16px;
                @children
            }
        }
        Rectangle {
            x: 0px;
            y: parent.height - 73px;
            width: 100%;
            height: 1px;
            background: ThemeTokens.outline.with-alpha(0.30);
        }
    }
}

component DialogInfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 40px;
    background: transparent;
    HorizontalLayout {
        Text {
            width: 34%;
            text: root.label;
            color: ThemeTokens.on-surface-variant;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: ThemeTokens.on-surface;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: ThemeTokens.outline.with-alpha(0.3);
    }
}

component DiagnosticRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> badge: @tr("正常");
    in property <bool> show-action: false;
    callback rescan;

    height: 58px;
    border-radius: 8px;
    background: ThemeTokens.surface-container;
    HorizontalLayout {
        width: parent.width;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        cross-axis-alignment: center;
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text { text: root.title; color: ThemeTokens.on-surface; font-size: 13px; font-weight: 700; }
            Text { text: root.description; color: ThemeTokens.on-surface-variant; font-size: 11px; wrap: word-wrap; }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        if root.badge != "" : Rectangle {
            width: 38px;
            height: 20px;
            border-radius: 5px;
            background: ThemeTokens.success.with-alpha(0.13);
            Text { text: root.badge; color: ThemeTokens.success; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
        }
        if root.show-action : Rectangle {
            width: action-label.preferred-width + 16px;
            height: 30px;
            border-radius: 6px;
            background: action.has-hover ? ThemeTokens.primary-container.with-alpha(0.45) : transparent;
            action-label := Text { width: 100%; height: 100%; text: @tr("重新扫描"); color: ThemeTokens.primary; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            action := TouchArea { mouse-cursor: pointer; clicked => { root.rescan(); } }
        }
    }
}

export component DialogLayer inherits Rectangle {
    in property <length> viewport-width: 800px;
    in property <length> viewport-height: 600px;
    in property <bool> text-open: false;
    in-out property <string> text-value: "";
    in property <bool> history-open: false;
    in property <[HistoryItem]> history-items: [];
    in property <bool> message-open: false;
    in property <string> message-sender: "";
    in property <string> message-device: "";
    in property <string> message-text: "";
    in property <bool> info-open: false;
    in property <string> info-alias: "";
    in property <string> info-ip: "";
    in property <string> info-port: "";
    in property <string> info-status: "";
    in property <string> info-fingerprint: "";
    in property <string> info-protocol: "HTTPS · LocalSend v2.1";
    in property <bool> manual-open: false;
    in-out property <string> manual-target: "";
    in property <bool> favorites-open: false;
    in property <[FavoriteItem]> favorites: [];
    in property <[DeviceItem]> devices: [];
    in property <bool> troubleshoot-open: false;
    in property <bool> pin-open: false;
    in-out property <string> pin-value: "";
    in property <string> pin-transfer-id: "";
    in property <bool> setting-open: false;
    in-out property <string> setting-value: "";
    in property <string> setting-key: "";
    in property <bool> web-share-open: false;
    in property <bool> web-share-running: false;
    in property <string> web-share-url: "";
    in property <bool> web-share-encryption: false;
    in property <bool> web-share-auto-accept: false;
    in property <bool> web-share-pin-enabled: false;
    in property <bool> completion-open: false;
    in property <string> completion-file-name: "";
    in property <string> completion-file-path: "";
    in-out property <int> completion-countdown: 0;
    in property <bool> auto-save-help-open: false;
    in property <bool> language-open: false;
    in property <[LanguageItem]> language-items: [];
    in property <string> language-code: "system";

    callback send-text(string);
    callback cancel-text();
    callback clear-history();
    callback open-destination();
    callback close-history();
    callback open-history-path(string);
    callback open-history-message(string, string);
    callback close-message();
    callback copy-message();
    callback close-info();
    callback close-language();
    callback language-selected(string);
    callback add-manual(string);
    callback close-manual();
    callback toggle-favorite(string);
    callback close-favorites();
    callback send-multi();
    callback open-firewall();
    callback close-troubleshoot();
    callback retry-pin(string, string);
    callback cancel-pin();
    callback submit-setting(string, string);
    callback cancel-setting();
    callback start-web-share();
    callback stop-web-share();
    callback copy-web-share-url();
    callback open-web-share-url();
    callback close-web-share();
    callback toggle-web-share-encryption(bool);
    callback toggle-web-share-auto-accept(bool);
    callback toggle-web-share-pin(bool);
    callback open-completion();
    callback reveal-completion();
    callback close-completion();
    callback close-auto-save-help();
    callback copy-diagnostics();
    callback open-favorites-from-auto-save();

    width: 100%;
    height: 100%;
    background: transparent;

    Timer {
        interval: 1s;
        running: root.completion-open && root.completion-countdown > 0;
        triggered => {
            if root.completion-countdown <= 1 {
                root.close-completion();
            } else {
                root.completion-countdown -= 1;
            }
        }
    }

    if root.text-open : DialogShell {
        title: @tr("发送文本");
        subtitle: @tr("文本会作为 .txt 文件发送到所选设备");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        target-width: 600px;
        target-height: 380px;
        close-clicked => { root.cancel-text(); }
        VerticalLayout {
            spacing: 6px;
            Text {
                text: @tr("文本内容");
                color: ThemeTokens.on-surface-variant;
                font-size: 12px;
                font-weight: 550;
                height: 18px;
            }
            Rectangle {
                height: 150px;
                border-radius: ThemeTokens.input-radius;
                border-width: 1px;
                border-color: ThemeTokens.outline;
                background: ThemeTokens.surface-lowest;
                TextInput {
                    x: 12px;
                    y: 11px;
                    width: parent.width - 24px;
                    height: parent.height - 22px;
                    text <=> root.text-value;
                    accessible-role: text-input;
                    accessible-label: @tr("发送文本内容");
                    accessible-value <=> root.text-value;
                    accessible-action-set-value(value) => { root.text-value = value; }
                    single-line: false;
                    wrap: word-wrap;
                    color: ThemeTokens.on-surface;
                    selection-background-color: ThemeTokens.primary;
                    selection-foreground-color: ThemeTokens.on-primary;
                    font-size: 13px;
                    line-height-factor: 1.08;
                }
            }
            Text {
                text: root.text-value.character-count + " / 10000";
                color: ThemeTokens.on-surface-variant;
                font-size: 11px;
                horizontal-alignment: right;
                height: 16px;
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { automation-id: "text-cancel"; label: @tr("取消"); clicked => { root.cancel-text(); } }
                FlutterDialogButton { automation-id: "text-send"; label: @tr("确定"); primary: true; clicked => { if root.text-value != "" { root.send-text(root.text-value); } } }
            }
        }
    }

    if root.history-open : DialogShell {
        title: @tr("历史记录");
        subtitle: @tr("搜索消息、文件名或设备");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        target-width: 640px;
        target-height: 498px;
        close-clicked => { root.close-history(); }
        VerticalLayout {
            spacing: 12px;
            search-field := Rectangle {
                height: 38px;
                property <bool> search-empty: search-input.text == "";
                border-radius: ThemeTokens.input-radius;
                border-width: 1px;
                border-color: ThemeTokens.outline;
                background: ThemeTokens.surface-lowest;
                HorizontalLayout {
                    padding-left: 11px;
                    padding-right: 11px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Image { width: 18px; height: 18px; source: @image-url("../icons/search.svg"); colorize: ThemeTokens.on-surface-variant; image-fit: contain; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: parent.height;
                        background: transparent;
                        search-input := TextInput {
                            width: parent.width;
                            height: parent.height;
                            color: search-field.search-empty ? transparent : ThemeTokens.on-surface;
                            font-size: 13px;
                            single-line: true;
                        }
                    }
                }
                if search-input.text == "" : Text {
                    z: 2;
                    x: 40px;
                    width: parent.width - 51px;
                    height: parent.height;
                    text: @tr("搜索历史");
                    color: ThemeTokens.on-surface-variant;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: always-off;
                content-height: max(self.visible-height, root.history-items.length * 76px);
                VerticalLayout {
                    padding-left: 0px;
                    padding-right: 0px;
                    padding-top: 5px;
                    spacing: 8px;
                    if root.history-items.length == 0 : Rectangle {
                        height: 180px;
                        background: transparent;
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Image { width: 32px; height: 32px; source: @image-url("../icons/history.svg"); colorize: ThemeTokens.on-surface-variant; image-fit: contain; }
                            Text { text: @tr("还没有接收记录"); color: ThemeTokens.on-surface-variant; font-size: 14px; horizontal-alignment: center; }
                        }
                    }
                    for item in root.history-items : Rectangle {
                        accessible-role: groupbox;
                        accessible-label: item.name;
                        accessible-id: "history-row-" + item.id;
                        height: item.message != "" ? 78px : 58px;
                        border-radius: 8px;
                        background: hover.has-hover ? ThemeTokens.surface-container-high : ThemeTokens.surface-container;
                        HorizontalLayout {
                            width: parent.width;
                            padding-left: 10px;
                            padding-right: 20px;
                            spacing: 12px;
                            VerticalLayout {
                                height: parent.height;
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { height: 18px; text: item.name; color: ThemeTokens.on-surface; font-size: 13px; font-weight: 700; overflow: elide; }
                                if item.is-message : Text { height: 18px; text: item.message; color: ThemeTokens.on-surface-variant; font-size: 11px; overflow: elide; }
                                Text { height: 18px; text: item.subtitle; color: ThemeTokens.on-surface-variant; font-size: 11px; overflow: elide; }
                                if !item.is-message && item.message != "" : Text { height: 18px; text: item.message; color: ThemeTokens.on-surface-variant; font-size: 11px; overflow: elide; }
                            }
                            Text {
                                width: 54px;
                                text: item.is-message ? @tr("复制") : @tr("打开文件");
                                color: ThemeTokens.primary;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        hover := TouchArea {
                            clicked => {
                                if (item.is-message) {
                                    root.open-history-message(item.message, item.subtitle);
                                } else if (item.path != "") {
                                    root.open-history-path(item.path);
                                }
                            }
                        }
                    }
                }
            }
            Text { text: @tr("历史记录只保存在当前设备，不会同步到云服务。"); color: ThemeTokens.on-surface-variant; font-size: 12px; height: 18px; vertical-alignment: center; }
            Rectangle { height: 10px; background: transparent; }
            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                horizontal-stretch: 1;
                FlutterDialogButton { width: 78px; label: @tr("清空历史"); enabled: root.history-items.length > 0; clicked => { root.clear-history(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { width: 50px; label: @tr("关闭"); clicked => { root.close-history(); } }
            }
        }
    }

    if root.message-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: ThemeTokens.surface;

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding-left: 48px;
            padding-right: 48px;
            padding-top: 36px;
            padding-bottom: 36px;
            spacing: 14px;
            alignment: center;

            Text {
                text: root.message-sender;
                color: ThemeTokens.on-surface;
                font-size: 42px;
                font-weight: 400;
                horizontal-alignment: center;
                overflow: elide;
            }
            if root.message-device != "" : Rectangle {
                height: 32px;
                width: device-label.preferred-width + 24px;
                border-radius: 7px;
                background: ThemeTokens.secondary-container;
                device-label := Text {
                    text: root.message-device;
                    color: ThemeTokens.on-secondary-container;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: @tr("发送给你了一条消息：");
                color: ThemeTokens.on-surface;
                font-size: 16px;
                horizontal-alignment: center;
            }
            Rectangle {
                width: min(640px, parent.width - 48px);
                height: 180px;
                border-radius: 16px;
                background: ThemeTokens.surface-container-high;
                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, message-body.preferred-height + 28px);
                    message-body := Text {
                        x: 16px;
                        y: 14px;
                        width: parent.width - 32px;
                        text: root.message-text;
                        color: ThemeTokens.on-surface;
                        font-size: 18px;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                height: 48px;
                spacing: 18px;
                alignment: center;
                FlutterDialogButton {
                    automation-id: "message-copy";
                    label: @tr("复制");
                    primary: true;
                    clicked => { root.copy-message(); }
                }
                FlutterDialogButton {
                    automation-id: "message-close";
                    label: @tr("关闭");
                    clicked => { root.close-message(); }
                }
            }
        }
    }

    if root.info-open : DialogShell {
        title: @tr("网络信息");
        subtitle: @tr("当前接收服务的连接信息");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        target-width: 520px;
        target-height: 432px;
        close-clicked => { root.close-info(); }
        VerticalLayout {
            spacing: 0px;
            DialogInfoRow { label: "Alias"; value: root.info-alias; }
            DialogInfoRow { label: @tr("IP 地址"); value: root.info-ip; }
            DialogInfoRow { label: @tr("端口"); value: root.info-port; }
            DialogInfoRow { label: @tr("协议"); value: root.info-protocol; }
            DialogInfoRow { label: @tr("网络"); value: "Wi-Fi · en0"; }
            DialogInfoRow { label: @tr("指纹"); value: root.info-fingerprint; }
            Rectangle { vertical-stretch: 1; background: transparent; }
            HorizontalLayout {
                height: 40px;
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { width: 50px; label: @tr("关闭"); clicked => { root.close-info(); } }
            }
        }
    }

    if root.manual-open : DialogShell {
        title: @tr("手动连接");
        subtitle: @tr("输入同一网络中设备的 IP 地址");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        target-width: 480px;
        target-height: 240px;
        close-clicked => { root.close-manual(); }
        VerticalLayout {
            spacing: 6px;
            Text { text: @tr("IP 地址或主机名"); color: ThemeTokens.on-surface-variant; font-size: 12px; font-weight: 550; line-height-factor: 1.17; }
            Rectangle {
                height: 34px;
                border-radius: ThemeTokens.input-radius;
                border-width: 1px;
                border-color: ThemeTokens.outline;
                background: ThemeTokens.surface-lowest;
                TextInput {
                    x: 10px;
                    y: 1px;
                    width: parent.width - 20px;
                    height: 32px;
                    text <=> root.manual-target;
                    accessible-role: text-input;
                    accessible-label: @tr("目标地址");
                    accessible-value <=> root.manual-target;
                    accessible-action-set-value(value) => { root.manual-target = value; }
                    color: ThemeTokens.on-surface;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { label: @tr("取消"); clicked => { root.close-manual(); } }
                FlutterDialogButton { label: @tr("连接"); primary: true; enabled: root.manual-target != ""; clicked => { root.add-manual(root.manual-target); } }
            }
        }
    }

    if root.favorites-open : DialogShell {
        title: @tr("收藏设备");
        subtitle: @tr("收藏设备可使用快速保存与快捷发送");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        target-width: 520px;
        target-height: 309px;
        close-clicked => { root.close-favorites(); }
        VerticalLayout {
            spacing: 8px;
            ScrollView {
                vertical-stretch: 1;
                content-height: max(self.visible-height, root.favorites.length * 64px);
                VerticalLayout {
                    spacing: 8px;
                    if root.favorites.length == 0 : Text { text: @tr("还没有收藏设备"); color: ThemeTokens.on-surface-variant; font-size: 13px; height: 36px; vertical-alignment: center; }
                    for favorite in root.favorites : Rectangle {
                        height: 60px;
                        border-radius: 8px;
                        background: ThemeTokens.surface-container;
                        HorizontalLayout {
                            width: parent.width;
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 12px;
                            VerticalLayout {
                                height: parent.height;
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: favorite.alias; color: ThemeTokens.on-surface; font-size: 13px; font-weight: 700; overflow: elide; }
                                Text { text: @tr("已验证 · 快速保存已开启"); color: ThemeTokens.on-surface-variant; font-size: 11px; }
                            }
                            FlutterIconButton { width: 40px; tooltip: @tr("移除收藏"); icon: @image-url("../icons/trash.svg"); clicked => { root.toggle-favorite(favorite.fingerprint); } }
                        }
                    }
                }
            }
            HorizontalLayout {
                height: 40px;
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { width: 50px; label: @tr("关闭"); clicked => { root.close-favorites(); } }
            }
        }
    }

    if root.completion-open : DialogShell {
        title: @tr("传输完成");
        subtitle: @tr("所有文件均已通过 Checksum 校验");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        target-width: 520px;
        target-height: 431px;
        close-clicked => { root.close-completion(); }
        VerticalLayout {
            spacing: 16px;
            HorizontalLayout {
                height: 66px;
                spacing: 12px;
                Rectangle { horizontal-stretch: 1; border-radius: 8px; background: ThemeTokens.surface-lowest.with-alpha(0.6); VerticalLayout { alignment: center; spacing: 2px; Text { text: "1"; font-size: 18px; font-weight: 700; horizontal-alignment: center; } Text { text: @tr("文件"); color: ThemeTokens.on-surface-variant; font-size: 11px; horizontal-alignment: center; } } }
                Rectangle { horizontal-stretch: 1; border-radius: 8px; background: ThemeTokens.surface-lowest.with-alpha(0.6); VerticalLayout { alignment: center; spacing: 2px; Text { text: "OK"; font-size: 18px; font-weight: 700; horizontal-alignment: center; } Text { text: "Checksum"; color: ThemeTokens.on-surface-variant; font-size: 11px; horizontal-alignment: center; } } }
                Rectangle { horizontal-stretch: 1; border-radius: 8px; background: ThemeTokens.surface-lowest.with-alpha(0.6); VerticalLayout { alignment: center; spacing: 2px; Text { text: @tr("完成"); font-size: 18px; font-weight: 700; horizontal-alignment: center; } Text { text: @tr("状态"); color: ThemeTokens.on-surface-variant; font-size: 11px; horizontal-alignment: center; } } }
            }
            Text { text: root.completion-file-name; color: ThemeTokens.on-surface-variant; font-size: 12px; overflow: elide; }
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 8px;
                FlutterDialogButton { label: @tr("打开"); primary: true; enabled: root.completion-file-path != ""; clicked => { root.open-completion(); } }
                FlutterDialogButton { label: @tr("在文件管理器中显示"); enabled: root.completion-file-path != ""; clicked => { root.reveal-completion(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton {
                    label: root.completion-countdown > 0 ? @tr("关闭 ({})", root.completion-countdown) : @tr("关闭");
                    clicked => { root.close-completion(); }
                }
            }
        }
    }

    if root.auto-save-help-open : DialogShell {
        title: @tr("快速保存说明");
        subtitle: @tr("可信设备可以跳过每次接收确认");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        target-width: 540px;
        target-height: 270px;
        close-clicked => { root.close-auto-save-help(); }
        VerticalLayout {
            spacing: 14px;
            Text {
                text: @tr("「收藏设备」只会自动接受来自已验证收藏设备的请求。文件保存到当前接收目录，并继续显示在历史记录中。");
                color: ThemeTokens.on-surface;
                font-size: 14px;
                line-height-factor: 1.17;
                wrap: word-wrap;
            }
            Text {
                text: @tr("若设备指纹发生变化，LocalSend 会重新要求确认。你可以随时在收藏设备中取消信任。");
                color: ThemeTokens.on-surface-variant;
                font-size: 12px;
                line-height-factor: 1.17;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            HorizontalLayout {
                height: 40px;
                horizontal-stretch: 1;
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { width: 50px; label: @tr("关闭"); clicked => { root.close-auto-save-help(); } }
                FlutterDialogButton { width: 118px; label: @tr("管理收藏设备"); primary: true; clicked => { root.open-favorites-from-auto-save(); } }
            }
        }
    }

    if root.troubleshoot-open : DialogShell {
        title: @tr("故障排除");
        subtitle: @tr("按顺序检查设备发现和连接");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        target-width: 600px;
        target-height: 436px;
        close-clicked => { root.close-troubleshoot(); }
        VerticalLayout {
            spacing: 8px;
            DiagnosticRow { title: @tr("网络连接"); description: "Wi-Fi · en0 · " + root.info-ip; }
            DiagnosticRow { title: @tr("本地端口"); description: @tr("TCP {} 正在监听", root.info-port); }
            DiagnosticRow { title: "Multicast " + @tr("发现"); description: @tr("最近一次响应：刚刚"); }
            DiagnosticRow {
                title: @tr("另一台设备未出现？");
                description: @tr("确认双方处于同一子网，并允许防火墙访问 LocalSend。");
                badge: "";
                show-action: true;
                rescan => { root.close-troubleshoot(); }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { width: 50px; label: @tr("关闭"); clicked => { root.close-troubleshoot(); } }
                FlutterDialogButton { width: 118px; label: @tr("复制诊断信息"); primary: true; clicked => { root.copy-diagnostics(); } }
            }
        }
    }

    if root.pin-open : DialogShell {
        title: @tr("设置 PIN");
        subtitle: @tr("接收文件前，发送方需要输入 4 位 PIN");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        target-width: 460px;
        target-height: 240px;
        close-clicked => { root.cancel-pin(); }
        VerticalLayout {
            spacing: 6px;
            Text { text: @tr("PIN 密码"); color: ThemeTokens.on-surface-variant; font-size: 12px; font-weight: 550; line-height-factor: 1.17; }
            Rectangle {
                height: 34px;
                border-radius: ThemeTokens.input-radius;
                border-width: 1px;
                border-color: ThemeTokens.outline;
                background: ThemeTokens.surface-lowest;
                TextInput {
                    x: 9px;
                    y: 1px;
                    width: parent.width - 18px;
                    height: 32px;
                    text <=> root.pin-value;
                    accessible-role: text-input;
                    accessible-label: @tr("PIN 值");
                    accessible-value <=> root.pin-value;
                    accessible-action-set-value(value) => { root.pin-value = value; }
                    color: ThemeTokens.on-surface;
                    font-size: 16px;
                    input-type: password;
                }
            }
            if root.pin-value.character-count > 0 && root.pin-value.character-count < 4 : Text { text: @tr("PIN 需要 4 位数字"); color: ThemeTokens.error; font-size: 12px; height: 16px; }
            Rectangle { vertical-stretch: 1; background: transparent; }
            HorizontalLayout {
                height: 40px;
                horizontal-stretch: 1;
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { width: 50px; automation-id: "pin-cancel"; label: @tr("取消"); clicked => { root.cancel-pin(); } }
                FlutterDialogButton { width: 62px; automation-id: "pin-retry"; label: @tr("确认"); primary: true; clicked => { if root.pin-value.character-count == 4 { root.retry-pin(root.pin-transfer-id, root.pin-value); } } }
            }
        }
    }

    if root.setting-open : DialogShell {
        title: @tr("编辑设置");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.cancel-setting(); }
        VerticalLayout {
            spacing: 12px;
            Text { text: root.setting-key; color: ThemeTokens.on-surface-variant; font-size: 13px; }
            Rectangle {
                height: 48px;
                border-radius: ThemeTokens.input-radius;
                background: ThemeTokens.surface-container-highest;
                TextInput {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: 32px;
                    text <=> root.setting-value;
                    accessible-role: text-input;
                    accessible-label: @tr("设置值");
                    accessible-value <=> root.setting-value;
                    accessible-action-set-value(value) => { root.setting-value = value; }
                    color: ThemeTokens.on-surface;
                    font-size: 15px;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { automation-id: "setting-cancel"; label: @tr("取消"); clicked => { root.cancel-setting(); } }
                FlutterDialogButton { automation-id: "setting-save"; label: @tr("保存"); primary: true; clicked => { root.submit-setting(root.setting-key, root.setting-value); } }
            }
        }
    }

    if root.web-share-open : DialogShell {
        title: @tr("通过链接接收");
        subtitle: @tr("浏览器可在同一网络内访问此地址");
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        target-width: 560px;
        target-height: 314px;
        close-clicked => { root.close-web-share(); }
        VerticalLayout {
            spacing: 16px;
            VerticalLayout {
                height: 59px;
                spacing: 6px;
                Text { text: @tr("接收链接"); color: ThemeTokens.on-surface-variant; font-size: 12px; font-weight: 550; line-height-factor: 1.17; }
                Rectangle {
                    height: 34px;
                    border-radius: ThemeTokens.input-radius;
                    border-width: 1px;
                    border-color: ThemeTokens.outline;
                    background: ThemeTokens.surface-lowest;
                    Text {
                        x: 9px;
                        width: parent.width - 18px;
                        height: parent.height;
                        text: root.web-share-url;
                        color: ThemeTokens.on-surface;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Rectangle {
                height: 58px;
                border-radius: 8px;
                background: ThemeTokens.surface-container;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text { text: @tr("Web Share 已验证"); color: ThemeTokens.on-surface; font-size: 13px; font-weight: 700; }
                        Text { text: @tr("访问者需要通过 PIN 验证后才能上传文件。"); color: ThemeTokens.on-surface-variant; font-size: 12px; overflow: elide; }
                    }
                    Rectangle {
                        width: ready-label.preferred-width + 12px;
                        height: 20px;
                        border-radius: 5px;
                        background: ThemeTokens.success.with-alpha(0.13);
                        ready-label := Text { text: @tr("已就绪"); color: ThemeTokens.success; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { label: @tr("关闭"); clicked => { root.close-web-share(); } }
                FlutterDialogButton { width: 90px; label: @tr("复制链接"); primary: true; enabled: root.web-share-url != ""; clicked => { root.copy-web-share-url(); } }
            }
        }
    }

    // The language picker lists every bundled locale in a three-column grid;
    // "system" is the first entry and follows the OS locale.
    if root.language-open : DialogShell {
        title: @tr("语言");
        target-width: 620px;
        target-height: 620px;
        close-clicked => { root.close-language(); }
        Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            background: transparent;
            property <length> cell-width: (self.width - 12px) / 3;
            property <length> list-height: Math.ceil(root.language-items.length / 3) * 44px;
            ScrollView {
                width: parent.width;
                height: parent.height;
                content-width: self.visible-width;
                content-height: max(self.visible-height, root.language-items.length * 0px + list-height);
                for item[index] in root.language-items : Rectangle {
                    x: Math.mod(index, 3) * (cell-width + 6px);
                    y: Math.floor(index / 3) * 44px;
                    width: cell-width;
                    height: 38px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.language-code == item.code ? ThemeTokens.primary.with-alpha(0.55) : ThemeTokens.outline.with-alpha(0.30);
                    background: root.language-code == item.code ? ThemeTokens.primary.with-alpha(0.12) : ThemeTokens.surface-lowest;
                    accessible-role: button;
                    accessible-label: item.name;
                    accessible-checked: root.language-code == item.code;
                    Text {
                        x: 10px;
                        y: 0px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: item.name;
                        color: root.language-code == item.code ? ThemeTokens.primary : ThemeTokens.on-surface;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.language-selected(item.code); }
                    }
                }
            }
        }
    }
}
