msgid "记住本次窗口尺寸与位置"
msgstr "ចងចាំទំហំ និងទីតាំងបង្អួចនេះ។"

msgid "设备信息"
msgstr "ព័ត៌មានឧបករណ៍"

msgid "设备名称"
msgstr "ឈ្មោះឧបករណ៍៖"

msgid "设备型号"
msgstr "ម៉ូឌែលរបស់ឧបករណ៍"

msgid "设备已离线，请刷新设备列表"
msgstr "ឧបករណ៍បានទៅក្រៅបណ្តាញ; ធ្វើឱ្យបញ្ជីឧបករណ៍ឡើងវិញ"

msgid "设备类型"
msgstr "ប្រភេទឧបករណ៍"

msgid "设备详情"
msgstr "ព័ត៌មានលម្អិតឧបករណ៍"

msgid "设备身份、服务与发现协议。"
msgstr "អត្តសញ្ញាណឧបករណ៍ សេវាកម្ម និងពិធីការរកឃើញ។"

msgid "设置"
msgstr "ការកំណត់"

msgid "设置 PIN"
msgstr "កំណត់កូដ PIN"

msgid "设置值"
msgstr "ការកំណត់តម្លៃ"

msgid "设置已提交"
msgstr "បាន​ដាក់​ស្នើ​ការ​កំណត់"

msgid "访问者需要通过 PIN 验证后才能上传文件。"
msgstr "អ្នកទស្សនាត្រូវតែឆ្លងកាត់ការផ្ទៀងផ្ទាត់កូដ PIN មុនពេលពួកគេអាចផ្ទុកឯកសារឡើង។"

msgid "诊断"
msgstr "រោគវិនិច្ឆ័យ"

msgid "诊断信息已复制"
msgstr "ចម្លងរោគវិនិច្ឆ័យ"

msgid "语言"
msgstr "ភាសា"

msgid "请先选择文件、文件夹、文本或剪贴板，再选择设备发送"
msgstr "ជ្រើសរើសឯកសារ ថតឯកសារ អត្ថបទ ឬមាតិកាក្ដារតម្បៀតខ្ទាស់ មុនពេលជ្រើសរើសឧបករណ៍"

msgid "请先选择文件或文件夹"
msgstr "ជ្រើសរើសឯកសារ ឬថតឯកសារជាមុនសិន"

msgid "请先选择至少一个设备"
msgstr "ជ្រើសរើសយ៉ាងហោចណាស់ឧបករណ៍មួយ។"

msgid "请在系统设置中检查防火墙规则"
msgstr "ពិនិត្យមើលច្បាប់ជញ្ជាំងភ្លើងនៅក្នុងការកំណត់ប្រព័ន្ធ"

msgid "请求发送 {} 个项目"
msgstr "ចង់ផ្ញើធាតុ {}"

msgid "请输入设备 IP 地址或主机名"
msgstr "បញ្ចូលអាសយដ្ឋាន IP ឬឈ្មោះម៉ាស៊ីន"

msgid "请选择目标设备"
msgstr "ជ្រើសរើសឧបករណ៍គោលដៅ"

msgid "跟随系统"
msgstr "តាមប្រព័ន្ធ"

msgid "跟随系统或固定使用浅色、深色"
msgstr "អនុវត្តតាមប្រព័ន្ធ ឬជួសជុលពន្លឺ ឬងងឹត"

msgid "路径可在文件管理器中打开"
msgstr "ផ្លូវអាចត្រូវបានបើកនៅក្នុងកម្មវិធីគ្រប់គ្រងឯកសារ"

msgid "输入同一网络中设备的 IP 地址"
msgstr "បញ្ចូលអាសយដ្ឋាន IP របស់ឧបករណ៍នៅលើបណ្តាញតែមួយ"

msgid "返回"
msgstr "ត្រឡប់មកវិញ"

msgid "还没有接收记录"
msgstr "មិនទាន់ទទួលបានរបស់របរទេ។"

msgid "还没有收藏设备"
msgstr "មិនមានឧបករណ៍ដែលចូលចិត្តនៅឡើយ"

msgid "连接"
msgstr "ភ្ជាប់"

msgid "退出"
msgstr "ឈប់"

msgid "退出时保存窗口位置"
msgstr "រក្សាទុកផ្ទាំងវីនដូ ក្រោយពេលចាកចេញ"

msgid "选择"
msgstr "ការជ្រើសរើស"

msgid "选择要发送的内容，或从剪贴板快速创建一条文本消息。"
msgstr "ជ្រើសរើសអ្វីដែលត្រូវផ្ញើ ឬបង្កើតសារជាអក្សរយ៉ាងរហ័សពីក្តារតម្បៀតខ្ទាស់។"

msgid "通用"
msgstr "ទិដ្ឋភាពទូទៅ"

msgid "通过链接接收"
msgstr "ទទួលតាមរយៈតំណ"

msgid "重启"
msgstr "ចាប់ផ្តើមឡើងវិញ"

msgid "重新启动接收"
msgstr "ចាប់ផ្តើមការទទួលឡើងវិញ"

msgid "重新扫描"
msgstr "ស្កេនឡើងវិញ"

msgid "附近的设备"
msgstr "ឧបករណ៍ដែលនៅជិតនេះ"

msgid "附近设备中显示的 alias"
msgstr "ឈ្មោះក្លែងក្លាយត្រូវបានបង្ហាញទៅឧបករណ៍ដែលនៅជិត"

msgid "隐私政策"
msgstr "ច្បាប់ស្តីអំពីឯកជនភាព"

msgid "颜色"
msgstr "ពណ៌"

msgid "验证"
msgstr "ផ្ទៀងផ្ទាត់"
