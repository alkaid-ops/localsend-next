msgstr "குறைந்தபட்சம் ஒரு சாதனத்தைத் தேர்ந்தெடுக்கவும்"

msgid "请在系统设置中检查防火墙规则"
msgstr "கணினி அமைப்புகளில் ஃபயர்வால் விதிகளை சரிபார்க்கவும்"

msgid "请求发送 {} 个项目"
msgstr "{} உருப்படிகளை அனுப்ப விரும்புகிறது"

msgid "请输入设备 IP 地址或主机名"
msgstr "சாதனத்தின் ஐபி முகவரி அல்லது ஹோஸ்ட்பெயரை உள்ளிடவும்"

msgid "请选择目标设备"
msgstr "இலக்கு சாதனத்தைத் தேர்ந்தெடுக்கவும்"

msgid "跟随系统"
msgstr "கணினி தீம்"

msgid "跟随系统或固定使用浅色、深色"
msgstr "கணினியைப் பின்பற்றவும் அல்லது ஒளி அல்லது இருட்டாக சரிசெய்யவும்"

msgid "路径可在文件管理器中打开"
msgstr "கோப்பு மேலாளரில் பாதையைத் திறக்கலாம்"

msgid "输入同一网络中设备的 IP 地址"
msgstr "அதே நெட்வொர்க்கில் உள்ள சாதனத்தின் ஐபி முகவரியை உள்ளிடவும்"

msgid "返回"
msgstr "மீண்டும்"

msgid "还没有接收记录"
msgstr "இதுவரை உருப்படிகள் எதுவும் பெறப்படவில்லை"

msgid "还没有收藏设备"
msgstr "பிடித்த சாதனங்கள் எதுவும் இல்லை"

msgid "连接"
msgstr "இணைக்கவும்"

msgid "退出"
msgstr "வெளியேறு"

msgid "退出时保存窗口位置"
msgstr "வெளியேறிய பிறகு சாளர நிலையை சேமிக்கவும்"

msgid "选择"
msgstr "தேர்வு"

msgid "选择要发送的内容，或从剪贴板快速创建一条文本消息。"
msgstr "எதை அனுப்ப வேண்டும் என்பதைத் தேர்வுசெய்யவும் அல்லது கிளிப்போர்டிலிருந்து உரைச் செய்தியை விரைவாக உருவாக்கவும்."

msgid "通用"
msgstr "பொது"

msgid "通过链接接收"
msgstr "இணைப்பு வழியாகப் பெறுக"

msgid "重启"
msgstr "மறுதொடக்கம்"

msgid "重新启动接收"
msgstr "பெறுவதை மீண்டும் தொடங்கவும்"

msgid "重新扫描"
msgstr "மீண்டும் ஸ்கேன் செய்யவும்"

msgid "附近的设备"
msgstr "அருகிலுள்ள சாதனங்கள்"

msgid "附近设备中显示的 alias"
msgstr "அருகிலுள்ள சாதனங்களுக்கு மாற்றுப்பெயர் காட்டப்பட்டுள்ளது"

msgid "隐私政策"
msgstr "தனியுரிமைக் கொள்கை"

msgid "颜色"
msgstr "நிறம்"

msgid "验证"
msgstr "சரிபார்"
