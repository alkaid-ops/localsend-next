import { ScrollView } from "std-widgets.slint";
import { FlutterDialogButton, FlutterIconButton, FlutterSettingsEntry } from "../components/common.slint";
import { ThemeTokens } from "../theme.slint";
import { DeviceItem, FavoriteItem, HistoryItem } from "../models.slint";
component DialogShell inherits Rectangle {
    in property <string> title;
    in property <length> viewport-width: 800px;
    in property <length> viewport-height: 600px;
    callback close-clicked;

    width: 100%;
    height: 100%;
    background: ThemeTokens.scrim;
    Rectangle {
        x: (parent.width - min(560px, parent.width - 48px)) / 2;
        y: (parent.height - min(460px, parent.height - 48px)) / 2;
        width: min(560px, parent.width - 48px);
        height: min(460px, parent.height - 48px);
        border-radius: ThemeTokens.dialog-radius;
        background: ThemeTokens.surface-container-high;
        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            HorizontalLayout {
                height: 40px;
                Text { text: root.title; color: ThemeTokens.on-surface; font-size: 22px; font-weight: 600; horizontal-stretch: 1; }
                FlutterIconButton { icon: @image-url("../icons/close.svg"); tooltip: "关闭"; clicked => { root.close-clicked(); } }
            }
            @children
        }
    }
}

export component DialogLayer inherits Rectangle {
    in property <length> viewport-width: 800px;
    in property <length> viewport-height: 600px;
    in property <bool> text-open: false;
    in-out property <string> text-value: "";
    in property <bool> history-open: false;
    in property <[HistoryItem]> history-items: [];
    in property <bool> message-open: false;
    in property <string> message-sender: "";
    in property <string> message-text: "";
    in property <bool> info-open: false;
    in property <string> info-alias: "";
    in property <string> info-ip: "";
    in property <string> info-port: "";
    in property <string> info-status: "";
    in property <bool> manual-open: false;
    in-out property <string> manual-target: "";
    in property <bool> favorites-open: false;
    in property <[FavoriteItem]> favorites: [];
    in property <[DeviceItem]> devices: [];
    in property <bool> send-mode-open: false;
    in property <int> send-mode: 0;
    in property <bool> troubleshoot-open: false;
    in property <bool> pin-open: false;
    in-out property <string> pin-value: "";
    in property <string> pin-transfer-id: "";
    in property <bool> setting-open: false;
    in-out property <string> setting-value: "";
    in property <string> setting-key: "";
    in property <bool> web-share-open: false;
    in property <bool> web-share-running: false;
    in property <string> web-share-url: "";

    callback send-text(string);
    callback cancel-text();
    callback clear-history();
    callback open-destination();
    callback close-history();
    callback open-history-path(string);
    callback open-history-message(string, string);
    callback close-message();
    callback copy-message();
    callback close-info();
    callback add-manual(string);
    callback close-manual();
    callback toggle-favorite(string);
    callback close-favorites();
    callback set-send-mode(int);
    callback send-multi();
    callback close-send-mode();
    callback open-firewall();
    callback close-troubleshoot();
    callback retry-pin(string, string);
    callback cancel-pin();
    callback submit-setting(string, string);
    callback cancel-setting();
    callback start-web-share();
    callback stop-web-share();
    callback copy-web-share-url();
    callback close-web-share();

    width: 100%;
    height: 100%;
    background: transparent;

    if root.text-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: ThemeTokens.scrim;
        Rectangle {
            x: (parent.width - min(540px, parent.width - 72px)) / 2;
            y: (parent.height - 280px) / 2;
            width: min(540px, parent.width - 72px);
            height: 280px;
            border-radius: ThemeTokens.dialog-radius;
            background: ThemeTokens.surface-container-high;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: "发送文本"; color: ThemeTokens.on-surface; font-size: 22px; font-weight: 600; }
                Rectangle {
                    height: 120px;
                    border-radius: ThemeTokens.input-radius;
                    background: ThemeTokens.surface-container-highest;
                    TextInput {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        text <=> root.text-value;
                        single-line: false;
                        wrap: word-wrap;
                        color: ThemeTokens.on-surface;
                        selection-background-color: ThemeTokens.primary;
                        selection-foreground-color: ThemeTokens.on-primary;
                        font-size: 16px;
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    FlutterDialogButton { label: "取消"; clicked => { root.cancel-text(); } }
                    FlutterDialogButton { label: "发送"; primary: true; enabled: root.text-value != ""; clicked => { root.send-text(root.text-value); } }
                }
            }
        }
    }

    if root.history-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: ThemeTokens.scrim;
        Rectangle {
            x: (parent.width - min(720px, parent.width - 80px)) / 2;
            y: (parent.height - min(560px, parent.height - 80px)) / 2;
            width: min(720px, parent.width - 80px);
            height: min(560px, parent.height - 80px);
            border-radius: ThemeTokens.dialog-radius;
            background: ThemeTokens.surface-container-high;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                HorizontalLayout {
                    height: 40px;
                    Text { text: "接收历史"; color: ThemeTokens.on-surface; font-size: 22px; font-weight: 600; horizontal-stretch: 1; }
                    FlutterIconButton { icon: @image-url("../icons/close.svg"); tooltip: "关闭"; clicked => { root.close-history(); } }
                }
                ScrollView {
                    vertical-stretch: 1;
                    content-height: max(self.visible-height, root.history-items.length * 74px);
                    VerticalLayout {
                        spacing: 6px;
                        if root.history-items.length == 0 : Text { text: "还没有接收记录"; color: ThemeTokens.on-surface-variant; font-size: 15px; }
                        for item in root.history-items : Rectangle {
                            height: item.is-message ? 86px : 66px;
                            border-radius: ThemeTokens.card-radius;
                            background: ThemeTokens.surface-container;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 3px;
                                Text { text: item.name; color: ThemeTokens.on-surface; font-size: 15px; font-weight: 600; overflow: elide; }
                                Text { text: item.subtitle; color: ThemeTokens.on-surface-variant; font-size: 12px; overflow: elide; }
                                if item.is-message : Text { text: item.message; color: ThemeTokens.on-surface; font-size: 13px; wrap: word-wrap; }
                                if item.path != "" : Text { text: item.path; color: ThemeTokens.primary; font-size: 12px; overflow: elide; }
                            }
                            TouchArea {
                                clicked => {
                                    if (item.is-message) {
                                        root.open-history-message(item.message, item.subtitle);
                                    } else if (item.path != "") {
                                        root.open-history-path(item.path);
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    FlutterDialogButton { label: "打开接收目录"; clicked => { root.open-destination(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    FlutterDialogButton { label: "清空历史"; enabled: root.history-items.length > 0; clicked => { root.clear-history(); } }
                    FlutterDialogButton { label: "关闭"; primary: true; clicked => { root.close-history(); } }
                }
            }
        }
    }

    if root.message-open : DialogShell {
        title: "文本消息";
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.close-message(); }
        Text {
            text: root.message-sender;
            color: ThemeTokens.on-surface-variant;
            font-size: 13px;
            overflow: elide;
        }
        Rectangle {
            vertical-stretch: 1;
            border-radius: ThemeTokens.card-radius;
            background: ThemeTokens.surface-container;
            ScrollView {
                width: parent.width;
                height: parent.height;
                content-width: self.visible-width;
                content-height: max(self.visible-height, message-body.preferred-height + 24px);
                message-body := Text {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    text: root.message-text;
                    color: ThemeTokens.on-surface;
                    font-size: 15px;
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; background: transparent; }
            FlutterDialogButton { label: "复制"; primary: true; clicked => { root.copy-message(); } }
            FlutterDialogButton { label: "关闭"; clicked => { root.close-message(); } }
        }
    }

    if root.info-open : DialogShell {
        title: "网络信息";
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.close-info(); }
        VerticalLayout {
            spacing: 14px;
            Text { text: "设备名称：" + root.info-alias; color: ThemeTokens.on-surface; font-size: 15px; }
            Text { text: "IP 地址：" + root.info-ip; color: ThemeTokens.on-surface; font-size: 15px; wrap: word-wrap; }
            Text { text: "端口：" + root.info-port; color: ThemeTokens.on-surface; font-size: 15px; }
            Text { text: "状态：" + root.info-status; color: ThemeTokens.on-surface-variant; font-size: 13px; wrap: word-wrap; }
        }
    }

    if root.manual-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: ThemeTokens.scrim;
        Rectangle {
            x: (parent.width - min(480px, parent.width - 80px)) / 2;
            y: (parent.height - 250px) / 2;
            width: min(480px, parent.width - 80px);
            height: 250px;
            border-radius: ThemeTokens.dialog-radius;
            background: ThemeTokens.surface-container-high;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: "手动添加设备"; color: ThemeTokens.on-surface; font-size: 22px; font-weight: 600; }
                Rectangle {
                    height: 48px;
                    border-radius: ThemeTokens.input-radius;
                    background: ThemeTokens.surface-container-highest;
                    TextInput { x: 10px; y: 8px; width: parent.width - 20px; height: 32px; text <=> root.manual-target; color: ThemeTokens.on-surface; font-size: 15px; }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    FlutterDialogButton { label: "取消"; clicked => { root.close-manual(); } }
                    FlutterDialogButton { label: "添加"; primary: true; enabled: root.manual-target != ""; clicked => { root.add-manual(root.manual-target); } }
                }
            }
        }
    }

    if root.favorites-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: ThemeTokens.scrim;
        Rectangle {
            x: (parent.width - min(640px, parent.width - 80px)) / 2;
            y: (parent.height - min(560px, parent.height - 80px)) / 2;
            width: min(640px, parent.width - 80px);
            height: min(560px, parent.height - 80px);
            border-radius: ThemeTokens.dialog-radius;
            background: ThemeTokens.surface-container-high;
            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                HorizontalLayout {
                    height: 40px;
                    Text { text: "收藏设备"; color: ThemeTokens.on-surface; font-size: 22px; font-weight: 600; horizontal-stretch: 1; }
                    FlutterIconButton { icon: @image-url("../icons/close.svg"); tooltip: "关闭"; clicked => { root.close-favorites(); } }
                }
                Text { text: "收藏设备可用于自动保存规则。"; color: ThemeTokens.on-surface-variant; font-size: 13px; }
                ScrollView {
                    vertical-stretch: 1;
                    content-height: max(self.visible-height, (root.favorites.length + root.devices.length) * 58px);
                    VerticalLayout {
                        spacing: 6px;
                        for favorite in root.favorites : HorizontalLayout {
                            height: 50px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            Image { width: 20px; height: 20px; source: @image-url("../icons/heart.svg"); colorize: ThemeTokens.primary; image-fit: contain; }
                            Text { text: favorite.alias; color: ThemeTokens.on-surface; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                            FlutterDialogButton { label: "移除"; clicked => { root.toggle-favorite(favorite.fingerprint); } }
                        }
                        for device in root.devices : HorizontalLayout {
                            visible: !device.favorite;
                            height: 50px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            Image { width: 20px; height: 20px; source: @image-url("../icons/heart.svg"); colorize: ThemeTokens.on-surface-variant; image-fit: contain; }
                            Text { text: device.alias + " · " + device.ip; color: ThemeTokens.on-surface; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                            FlutterDialogButton { label: "收藏"; primary: true; clicked => { root.toggle-favorite(device.fingerprint); } }
                        }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    FlutterDialogButton { label: "关闭"; primary: true; clicked => { root.close-favorites(); } }
                }
            }
        }
    }

    if root.send-mode-open : DialogShell {
        title: "发送模式";
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.close-send-mode(); }
        VerticalLayout {
            spacing: 12px;
            Text { text: root.send-mode == 0 ? "单选模式：点击设备后立即发送。" : "多选模式：选择设备后按发送按钮。"; color: ThemeTokens.on-surface-variant; font-size: 14px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                FlutterDialogButton { label: "单选"; primary: root.send-mode == 0; clicked => { root.set-send-mode(0); } }
                FlutterDialogButton { label: "多选"; primary: root.send-mode == 1; clicked => { root.set-send-mode(1); } }
                FlutterDialogButton { label: "发送"; primary: true; enabled: root.send-mode == 1; clicked => { root.send-multi(); } }
            }
        }
    }

    if root.troubleshoot-open : DialogShell {
        title: "故障排除";
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.close-troubleshoot(); }
        VerticalLayout {
            spacing: 12px;
            Text { text: "设备不可见：确认设备连接到同一 Wi-Fi 或局域网，并检查防火墙权限。"; color: ThemeTokens.on-surface; font-size: 14px; wrap: word-wrap; }
            Text { text: "连接失败：检查端口、HTTPS、PIN 和目标设备的网络隔离设置。"; color: ThemeTokens.on-surface; font-size: 14px; wrap: word-wrap; }
            FlutterDialogButton { label: "打开防火墙设置"; clicked => { root.open-firewall(); } }
        }
    }

    if root.pin-open : DialogShell {
        title: "输入接收方 PIN";
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.cancel-pin(); }
        VerticalLayout {
            spacing: 12px;
            Text { text: "目标设备要求 PIN 才会接收传输。"; color: ThemeTokens.on-surface-variant; font-size: 14px; wrap: word-wrap; }
            Rectangle {
                height: 48px;
                border-radius: ThemeTokens.input-radius;
                background: ThemeTokens.surface-container-highest;
                TextInput { x: 10px; y: 8px; width: parent.width - 20px; height: 32px; text <=> root.pin-value; color: ThemeTokens.on-surface; font-size: 16px; }
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { label: "取消"; clicked => { root.cancel-pin(); } }
                FlutterDialogButton { label: "重试"; primary: true; enabled: root.pin-value != ""; clicked => { root.retry-pin(root.pin-transfer-id, root.pin-value); } }
            }
        }
    }

    if root.setting-open : DialogShell {
        title: "编辑设置";
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.cancel-setting(); }
        VerticalLayout {
            spacing: 12px;
            Text { text: root.setting-key; color: ThemeTokens.on-surface-variant; font-size: 13px; }
            Rectangle {
                height: 48px;
                border-radius: ThemeTokens.input-radius;
                background: ThemeTokens.surface-container-highest;
                TextInput { x: 10px; y: 8px; width: parent.width - 20px; height: 32px; text <=> root.setting-value; color: ThemeTokens.on-surface; font-size: 15px; }
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                FlutterDialogButton { label: "取消"; clicked => { root.cancel-setting(); } }
                FlutterDialogButton { label: "保存"; primary: true; clicked => { root.submit-setting(root.setting-key, root.setting-value); } }
            }
        }
    }

    if root.web-share-open : DialogShell {
        title: "通过链接接收";
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        close-clicked => { root.close-web-share(); }
        VerticalLayout {
            spacing: 12px;
            Text { text: root.web-share-running ? "浏览器可以使用此链接发送文件。" : "启动后，浏览器可通过此链接发送文件。"; color: ThemeTokens.on-surface-variant; font-size: 14px; wrap: word-wrap; }
            Text { text: root.web-share-url; color: ThemeTokens.primary; font-size: 15px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                FlutterDialogButton { label: root.web-share-running ? "停止" : "启动"; primary: !root.web-share-running; clicked => { if (root.web-share-running) { root.stop-web-share(); } else { root.start-web-share(); } } }
                FlutterDialogButton { label: "复制链接"; enabled: root.web-share-url != ""; clicked => { root.copy-web-share-url(); } }
            }
        }
    }
}

