import { ScrollView } from "std-widgets.slint";
import {
    FlutterDialogButton,
    FlutterIconButton,
    FlutterOutlinedButton,
} from "../components/common.slint";
import { ThemeTokens } from "../theme.slint";
import { RequestFileItem, TransferItem } from "../models.slint";

export component ReceivePage inherits Rectangle {
    in property <length> viewport-width: 800px;
    in property <length> viewport-height: 600px;
    in property <string> alias: "LocalSend";
    in property <string> device-id: "";
    in property <string> ip-summary: "Unknown";
    in property <string> port: "";
    in property <string> server-status: "";
    in property <bool> server-running: false;
    in property <string> request-id: "";
    in property <string> request-title: "";
    in property <[RequestFileItem]> request-files: [];
    in property <[string]> selected-request-ids: [];
    in property <[TransferItem]> transfers: [];
    callback show-history;
    callback show-info;
    callback open-web-share;
    callback toggle-request-file(string);
    callback respond-transfer(string, [string], bool);
    callback cancel-transfer(string);
    property <length> request-card-height: root.request-files.length > 0
        ? min(210px, 92px + root.request-files.length * 34px)
        : 0px;
    property <length> center-height: max(
        1px,
        root.viewport-height - 162px - (root.request-files.length > 0 ? root.request-card-height + 8px : 0px)
    );

    background: ThemeTokens.surface;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: ThemeTokens.receive-padding;
        padding-right: ThemeTokens.receive-padding;
        padding-top: 16px;
        padding-bottom: 20px;
        spacing: 8px;

        HorizontalLayout {
            height: 44px;
            horizontal-stretch: 1;
            Rectangle { horizontal-stretch: 1; background: transparent; }
            FlutterIconButton {
                icon: @image-url("../icons/history.svg");
                tooltip: "Receive history";
                clicked => { root.show-history(); }
            }
            FlutterIconButton {
                icon: @image-url("../icons/info.svg");
                tooltip: "Network information";
                clicked => { root.show-info(); }
            }
        }

        if root.request-files.length > 0 : Rectangle {
            horizontal-stretch: 1;
            height: root.request-card-height;
            border-radius: ThemeTokens.card-radius;
            background: ThemeTokens.surface-container-low;
            border-width: 1px;
            border-color: ThemeTokens.outline-variant;

            VerticalLayout {
                x: 16px;
                y: 10px;
                width: parent.width - 32px;
                spacing: 4px;
                Text {
                    text: root.request-title;
                    color: ThemeTokens.on-surface;
                    font-size: 16px;
                    font-weight: 600;
                }
                ScrollView {
                    height: min(78px, root.request-files.length * 28px);
                    content-height: max(self.visible-height, root.request-files.length * 28px);
                    VerticalLayout {
                        for file in root.request-files : Rectangle {
                            height: 26px;
                            background: transparent;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: file.selected ? "☑" : "☐";
                                    color: ThemeTokens.primary;
                                    font-size: 15px;
                                }
                                Text {
                                    text: file.name + " · " + file.size;
                                    color: ThemeTokens.on-surface-variant;
                                    font-size: 13px;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                            TouchArea {
                                clicked => { root.toggle-request-file(file.file-id); }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    FlutterDialogButton {
                        label: "拒绝";
                        clicked => { root.respond-transfer(root.request-id, [], false); }
                    }
                    FlutterDialogButton {
                        label: "接受所选";
                        primary: true;
                        clicked => { root.respond-transfer(root.request-id, root.selected-request-ids, true); }
                    }
                    FlutterDialogButton {
                        label: "全部接受";
                        clicked => { root.respond-transfer(root.request-id, [], true); }
                    }
                }
            }
        }

        Rectangle {
            height: root.center-height;
            horizontal-stretch: 1;
            background: transparent;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                alignment: center;
                spacing: 4px;
                HorizontalLayout {
                    width: parent.width;
                    height: min(200px, root.viewport-height * 0.28);
                    alignment: center;
                    Image {
                        width: min(200px, root.viewport-height * 0.28);
                        height: parent.height;
                        source: @image-url("../images/flutter-logo-512.png");
                        colorize: ThemeTokens.primary;
                        image-fit: contain;
                    }
                }
                Text {
                    text: root.alias;
                    color: ThemeTokens.on-surface;
                    font-size: 48px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.device-id;
                    color: ThemeTokens.on-surface-variant;
                    font-size: 24px;
                    horizontal-alignment: center;
                }
            }
        }

        if root.transfers.length > 0 : VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            for transfer in root.transfers : Rectangle {
                height: 48px;
                border-radius: ThemeTokens.card-radius;
                background: ThemeTokens.surface-container-low;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 10px;
                    alignment: center;
                    Text {
                        text: transfer.direction + " · " + transfer.peer + " · " + transfer.summary;
                        color: ThemeTokens.on-surface;
                        font-size: 13px;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    FlutterDialogButton {
                        width: 76px;
                        height: 34px;
                        label: "取消";
                        clicked => { root.cancel-transfer(transfer.transfer-id); }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 42px;
            alignment: center;
            FlutterOutlinedButton {
                label: "通过链接接收";
                clicked => { root.open-web-share(); }
            }
        }

        Text {
            text: root.server-status + (root.port == "" ? "" : " · " + root.port);
            color: root.server-running ? ThemeTokens.primary : ThemeTokens.on-surface-variant;
            font-size: 12px;
            height: 16px;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}
